{
  "name": "adopt-a-run",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "start": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "astro": "ASTRO_TELEMETRY_DISABLED=1 astro",
    "test": "vitest run && npm run check:design",
    "test:watch": "vitest",
    "typecheck": "ASTRO_TELEMETRY_DISABLED=1 astro check && tsc --noEmit",
    "check:design": "node .agents/skills/impeccable/scripts/detect.mjs src/",
    "generate:favicons": "node scripts/generate-favicons.mjs",
    "deploy": "ASTRO_TELEMETRY_DISABLED=1 astro build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.0",
    "@astrojs/react": "^4.4.2",
    "@nanostores/react": "^2.0.1",
    "@react-three/fiber": "^9.7.0",
    "@sanity/astro": "^3.5.1",
    "@sanity/icons": "^5.2.1",
    "@sanity/image-url": "^2.1.1",
    "@sanity/ui": "^4.0.7",
    "@shadergradient/react": "^2.4.20",
    "astro": "^7.3.1",
    "camera-controls": "^3.1.2",
    "groq": "^6.12.0",
    "nanostores": "^1.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sanity": "^6.12.0",
    "three": "^0.186.0",
    "three-stdlib": "^2.36.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@cloudflare/workers-types": "^5.20260907.1",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.185.4",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7",
    "wrangler": "^4.129.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true,
    "sharp@0.35.2": true,
    "sharp@0.35.4": true,
    "workerd@1.20260903.1": true
  }
}
