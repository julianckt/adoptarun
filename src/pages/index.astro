---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AboutSection from '@/components/AboutSection.astro';
import StatsSection from '@/components/StatsSection.astro';
import JourneySection from '@/components/JourneySection.astro';
import FeaturedRoutesSection from '@/components/FeaturedRoutesSection.astro';
import CharitySection from '@/components/CharitySection.astro';
import IslandVerification from '@/components/IslandVerification';
import RouteCard from '@/components/RouteCard.astro';
import ShaderBackgroundWrapper from '@/components/ShaderBackground/ShaderBackgroundWrapper.astro';
import { getRoutes } from '@/sanity/queries';
import type { SanityRoute } from '@/sanity/types';

const routes = await getRoutes();
const fallbackRoute: SanityRoute = {
  _id: 'sample-wan-chai',
  _type: 'route',
  title: 'Wan Chai Promenade',
  slug: { _type: 'slug', current: 'wan-chai-promenade' },
  animalType: 'dog',
  district: 'Wan Chai',
  region: 'Hong Kong Island',
  city: 'Hong Kong',
  distanceKm: 14,
  estimatedDurationMin: 10,
  elevationGain: 4,
  difficulty: 'beginner',
  colorTheme: 'route-orange',
  featured: true,
  routePolyline: '',
  description: 'Scenic flat route along Wan Chai Promenade',
  isGroupRun: false,
  tags: ['Near MTR', 'Traffic-Free Promenade Run'],
};

const activeRoute = routes?.[0] || fallbackRoute;
---

<BaseLayout title="adopt a run — gps art community movement" class="has-shader-bg">
  <ShaderBackgroundWrapper />
  <main>
    <!-- Fullscreen Hero Section -->
    <section class="hero-fullscreen" aria-label="Hero Section">
      <div class="hero-inner">
        <!-- Hero Section Main Row -->
        <div class="hero-main">
          <!-- Left Column: Wordmark & Tagline -->
          <div class="hero-header">
            <h1 class="hero-wordmark">
              <span class="hero-wordmark-line"><span class="hero-wordmark-adopt">adopt</span></span>
              <span class="hero-wordmark-line"><span class="hero-wordmark-thin hero-wordmark-a">a</span><span class="hero-wordmark-space">&nbsp;</span><span class="hero-wordmark-strong hero-wordmark-run">run</span></span>
            </h1>
            <p class="hero-tagline">the new way to push yourself in training and in giving back</p>
          </div>

          <!-- Right Column: Route Cards (repeated twice) -->
          <div class="hero-cards">
            <RouteCard route={activeRoute} />
            <RouteCard route={activeRoute} />
          </div>
        </div>

        <!-- Hero Bottom Bar -->
        <div class="hero-bottom">
          <p class="hero-mission">
            by bringing people together through long-distance running and community art, our project aims to help champion a kinder city — a city where our shared compassion moves us forward.
          </p>
          <a href="#lumos-showcase" class="hero-learn-more" aria-label="Learn more about adopt a run">
            learn more &darr;
          </a>
        </div>
      </div>
    </section>

    <!-- Observer Seam: Future Routes Feature Section will activate Shader Preset B (add id="routes-featured") -->

    <!-- Homepage Curtain: Opaque container that reveals shader on transparent sections -->
    <div class="homepage-curtain">
      <!-- Homepage About Section -->
      <AboutSection />

      <!-- Section 02: Live Community Movement Counters -->
      <StatsSection />

      <!-- Section 03: 3-Step Caretaker Journey -->
      <JourneySection />
    </div>

    <!-- Section 04: Featured GPS Art Routes (Outside Curtain on Canvas White) -->
    <FeaturedRoutesSection routes={routes} />

    <!-- Secondary Curtain: Preserves Lumos Showcase below Featured Routes -->
    <div class="homepage-curtain">
      <!-- Section 05: Partner Charities Spotlight (SPCA Feature) -->
      <CharitySection />

      <!-- Lumos Component Showcase & Verification (Preserved under Hero) -->
      <section id="lumos-showcase" class="u-container" style="max-width: 1100px; margin: 0 auto; padding: var(--space-10) var(--space-06);">
        <div style="display: flex; align-items: center; gap: var(--space-04); margin-bottom: var(--space-04);">
          <span class="badge-group-run">system verified</span>
          <span class="u-text-mono" style="font-size: var(--font-fluid-label); color: var(--color-text-secondary);">
            ticket #14 · lumos design system
          </span>
        </div>
        <h2 class="u-text-display" style="font-size: var(--font-fluid-title); margin-bottom: var(--space-06);">
          lumos component showcase
        </h2>
        <div class="u-grid-autofit" style="--grid-min: 380px; --grid-gap: var(--space-06); margin-bottom: var(--space-10);">
          <!-- Signature Route Card Component -->
          <RouteCard route={activeRoute} />

          <!-- Route Card Sample (Ad-hoc) -->
          <article class="card-route p-micro-frame">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-04);">
              <span class="badge-group-run">group run</span>
              <span class="u-text-mono" style="font-size: var(--font-size-label); font-weight: 500;">14km</span>
            </div>
            <h3 style="font-family: var(--font-body); font-size: var(--font-size-body); font-weight: 500; margin-bottom: var(--space-02);">
              happy valley boar
            </h3>
            <p style="font-family: var(--font-body); font-size: var(--font-size-label); line-height: var(--leading-body); margin-bottom: var(--space-06);">
              winding ridgeline loop tracing the northern contours through wanchai gap and bowen road.
            </p>
            <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-top: auto;">
              <span style="font-family: var(--font-body); font-size: var(--font-size-micro); font-weight: 500;">est. 85 min</span>
              <span style="font-family: var(--font-body); font-size: var(--font-size-micro); font-weight: 500;">elev. +320m</span>
            </div>
          </article>

          <!-- Island Verification Panel -->
          <div class="p-panel-floating" style="padding: var(--space-06);">
            <div style="margin-bottom: var(--space-04);">
              <span class="u-text-mono" style="font-size: var(--font-fluid-label); color: var(--color-text-muted);">
                interactive island
              </span>
            </div>
            <IslandVerification client:load title="interactive island smoke test" initialCount={1200} />
          </div>
        </div>
      </section>

      <!-- Observer Seam: Future Bottom CTA Section will activate Shader Preset A (add id="bottom-cta") -->
    </div>
  </main>
</BaseLayout>
