---
import ShaderBackground from './ShaderBackground';

export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['shader-background-viewport', className]} aria-hidden="true">
  <ShaderBackground client:idle={{ timeout: 800 }} />
</div>

<style>
  .shader-background-viewport {
    position: fixed;
    inset: 0 0 calc(-1 * var(--safe-inset-bottom)) 0;
    z-index: -1;
    pointer-events: none;
    background-color: transparent;
    overflow: hidden;
  }
</style>
