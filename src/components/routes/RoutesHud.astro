---
import type { SanityRoute } from '@/sanity/types';
import RouteCatalogue from '@/components/routes/RouteCatalogue.astro';

export interface Props {
  routes: SanityRoute[] | null;
  totalRoutes: number;
  totalKm: number;
  contactEmail: string;
}

const { routes = [], totalRoutes = 0, totalKm = 0, contactEmail = 'hello@adoptarun.org' } = Astro.props;

// Filter for upcoming group runs
const now = new Date().getTime();
const groupRuns = (routes || [])
  .filter((r) => {
    if (!r.isGroupRun || !r.groupRunDateTime) return false;
    const runTime = new Date(r.groupRunDateTime).getTime();
    // Pinned until 24 hours after meetup time
    return runTime + 24 * 60 * 60 * 1000 >= now;
  })
  .sort((a, b) => {
    const timeA = new Date(a.groupRunDateTime!).getTime();
    const timeB = new Date(b.groupRunDateTime!).getTime();
    return timeA - timeB;
  });

function formatGroupRunDate(dateStr?: string): string {
  if (!dateStr) return '';
  try {
    const date = new Date(dateStr);
    const day = date.toLocaleDateString('en-GB', { weekday: 'short' }).toLowerCase();
    const dayNum = date.getDate();
    const month = date.toLocaleDateString('en-GB', { month: 'short' }).toLowerCase();
    const hours = date.getHours().toString().padStart(2, '0');
    const mins = date.getMinutes().toString().padStart(2, '0');
    return `${day}, ${dayNum} ${month} · ${hours}:${mins}`;
  } catch {
    return dateStr;
  }
}

const mailtoSubject = encodeURIComponent('Suggest a GPS Art Route');
const mailtoHref = `mailto:${contactEmail}?subject=${mailtoSubject}`;
---

<div class="routes-hud page-frame" id="routes-hud">
  <!-- Top-Left Editorial Header & Difficulty Filter -->
  <header class="hud-top-left">
    <div class="hud-scrim hud-scrim--top-left" aria-hidden="true"></div>
    <div class="hud-top-left-content">
      <h1 class="hud-title">
        find your <span class="c-wordmark-run">run</span>
      </h1>

      <nav class="hud-difficulty-nav" aria-label="Filter routes by difficulty">
        <ul class="hud-difficulty-list" role="tablist">
          <li role="presentation">
            <button
              type="button"
              class="hud-difficulty-btn is-active"
              role="tab"
              aria-selected="true"
              data-difficulty="all"
            >
              <span class="hud-difficulty-label">all runs</span>
            </button>
          </li>
          <li class="hud-difficulty-sep" aria-hidden="true">·</li>
          <li role="presentation">
            <button
              type="button"
              class="hud-difficulty-btn"
              role="tab"
              aria-selected="false"
              data-difficulty="beginner"
            >
              <span class="hud-difficulty-label">beginner</span>
            </button>
          </li>
          <li class="hud-difficulty-sep" aria-hidden="true">·</li>
          <li role="presentation">
            <button
              type="button"
              class="hud-difficulty-btn"
              role="tab"
              aria-selected="false"
              data-difficulty="easy"
            >
              <span class="hud-difficulty-label">easy</span>
            </button>
          </li>
          <li class="hud-difficulty-sep" aria-hidden="true">·</li>
          <li role="presentation">
            <button
              type="button"
              class="hud-difficulty-btn"
              role="tab"
              aria-selected="false"
              data-difficulty="intermediate"
            >
              <span class="hud-difficulty-label">intermediate</span>
            </button>
          </li>
          <li class="hud-difficulty-sep" aria-hidden="true">·</li>
          <li role="presentation">
            <button
              type="button"
              class="hud-difficulty-btn"
              role="tab"
              aria-selected="false"
              data-difficulty="advanced"
            >
              <span class="hud-difficulty-label">expert</span>
            </button>
          </li>
        </ul>
      </nav>
    </div>
  </header>

  <!-- Top-Right View Switcher & Mobile Drawer Trigger -->
  <aside class="hud-top-right">
    <button
      type="button"
      class="hud-mobile-filter-trigger"
      id="hud-mobile-filter-trigger"
      aria-expanded="false"
      aria-controls="catalogue-filters-drawer"
      aria-label="Filter routes"
    >
      <span>filters</span>
      <span class="hud-filter-badge" id="hud-filter-badge" hidden>0</span>
      <span class="hud-filter-caret" aria-hidden="true">&#9662;</span>
    </button>
    <div class="hud-view-toggle" role="group" aria-label="Route view switcher">
      <button
        type="button"
        class="hud-view-btn is-active"
        id="view-toggle-map"
        aria-pressed="true"
        data-view="map"
      >
        <span class="hud-view-dot" aria-hidden="true">●</span>
        <span>map</span>
      </button>
      <button
        type="button"
        class="hud-view-btn"
        id="view-toggle-grid"
        aria-pressed="false"
        data-view="grid"
      >
        <span>grid</span>
      </button>
    </div>
  </aside>

  <!-- Bottom-Left Telemetry & Route Suggestion -->
  <footer class="hud-bottom-left">
    <div class="hud-scrim hud-scrim--bottom-left" aria-hidden="true"></div>
    <div class="hud-bottom-left-content">
      <p class="hud-telemetry">
        <span class="hud-telemetry-num">{totalRoutes}</span> routes · <span class="hud-telemetry-num">{totalKm.toFixed(1)}</span> km mapped
      </p>
      <a href={mailtoHref} class="hairline-link hairline-link--white hud-suggest-link">
        suggest a route &rarr;
      </a>
    </div>
  </footer>

  <!-- Bottom-Right Group Run Flight Board -->
  <section class="hud-bottom-right" id="group-flight-board" aria-label="Upcoming group runs board">
    <div class="flight-board-card">
      <div class="flight-board-header">
        <div class="flight-board-status">
          <span class="flight-board-pulse" aria-hidden="true">●</span>
          <span class="flight-board-title">upcoming group runs ({groupRuns.length})</span>
        </div>
        <button
          type="button"
          class="flight-board-toggle"
          id="flight-board-toggle"
          aria-expanded="true"
          aria-label="Toggle group runs board"
        >
          <span class="flight-toggle-icon" aria-hidden="true">&minus;</span>
        </button>
      </div>

      <div class="flight-board-wrapper">
        <div class="flight-board-body" id="flight-board-body">
          {groupRuns.length > 0 ? (
            <ul class="flight-board-list">
              {groupRuns.map((run) => (
                <li class="flight-run-item">
                  <div class="flight-run-meta">
                    <span class="flight-run-district">{run.district}</span>
                    <span class="flight-run-time">{formatGroupRunDate(run.groupRunDateTime)}</span>
                  </div>
                  <div class="flight-run-main">
                    <h2 class="flight-run-name">{run.title}</h2>
                    <span class="flight-run-distance">{run.distanceKm} km</span>
                  </div>
                  <div class="flight-run-footer">
                    <span class="flight-runner-badge">
                      {run.groupRunSignupCount || 12} runners
                    </span>
                    <button
                      type="button"
                      class="flight-focus-btn"
                      data-route-slug={run.slug.current}
                      data-district={run.district}
                    >
                      focus on map &rarr;
                    </button>
                  </div>
                </li>
              ))}
            </ul>
          ) : (
            <div class="flight-board-empty">
              <p>no group runs scheduled today.</p>
              <a href={mailtoHref} class="hairline-link hairline-link--white">
                host a group run &rarr;
              </a>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>
</div>

<!-- Route Catalogue View (Displayed when switching to Grid view) -->
<div class="routes-catalogue-view" id="routes-grid-view" hidden>
  <RouteCatalogue routes={routes} />
</div>

<style>
  .routes-hud {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 10;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    padding-block: var(--space-06);
    box-sizing: border-box;
    left: 0;
    right: 0;
  }

  /* Scrims for text contrast against map */
  .hud-scrim {
    position: absolute;
    pointer-events: none;
    z-index: -1;
  }

  .hud-scrim--top-left {
    inset: -24px -48px -32px -24px;
    background: radial-gradient(
      ellipse at top left,
      rgba(24, 19, 17, 0.92) 0%,
      rgba(24, 19, 17, 0.72) 45%,
      transparent 80%
    );
  }

  .hud-scrim--bottom-left {
    inset: -24px -32px -24px -24px;
    background: radial-gradient(
      ellipse at bottom left,
      rgba(24, 19, 17, 0.90) 0%,
      rgba(24, 19, 17, 0.60) 50%,
      transparent 85%
    );
  }

  /* Top-Left Section */
  .hud-top-left {
    grid-column: 1;
    grid-row: 1;
    position: relative;
    align-self: flex-start;
    justify-self: flex-start;
    pointer-events: auto;
    max-width: 580px;
  }

  .hud-top-left-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-04);
  }

  .hud-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(var(--font-size-metric), 4vw, var(--font-size-wordmark));
    font-weight: 500;
    line-height: var(--leading-compressed);
    color: var(--color-canvas-white);
    text-transform: lowercase;
  }

  /* Scale VF Wordmark for 'run' - optically balanced with Degular Display */
  .c-wordmark-run {
    font-family: var(--font-wordmark);
    font-size: 0.82em;
    font-weight: 900;
    font-variation-settings: 'wdth' 175, 'wght' 900;
    display: inline-block;
    vertical-align: baseline;
    line-height: inherit;
  }

  /* Difficulty Filter Nav */
  .hud-difficulty-nav {
    display: flex;
    align-items: center;
  }

  .hud-difficulty-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-03);
    list-style: none;
    padding: 0;
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--font-size-label);
  }

  .hud-difficulty-btn {
    display: inline-flex;
    align-items: center;
    background: transparent;
    border: none;
    padding: var(--space-01) var(--space-02);
    color: var(--color-text-secondary);
    font-family: var(--font-body);
    font-size: var(--font-size-label);
    font-weight: 400;
    cursor: pointer;
    text-transform: lowercase;
    transition: color var(--duration-fast) var(--ease-out-expo), font-weight var(--duration-fast) var(--ease-out-expo);
  }

  .hud-difficulty-btn:hover {
    color: var(--color-canvas-white);
  }

  .hud-difficulty-btn.is-active {
    color: var(--color-canvas-white);
    font-weight: 500;
  }

  .hud-difficulty-sep {
    color: rgba(255, 251, 249, 0.25);
    user-select: none;
  }

  /* Top-Right View Switcher */
  .hud-top-right {
    grid-column: 2;
    grid-row: 1;
    align-self: flex-start;
    justify-self: flex-end;
    pointer-events: auto;
  }

  .hud-view-toggle {
    display: inline-flex;
