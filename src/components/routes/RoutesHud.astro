    background-color: rgba(24, 19, 17, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: var(--rounded-none);
    overflow: hidden;
  }

  .hud-view-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-02);
    background: transparent;
    border: none;
    padding: var(--space-02) var(--space-05);
    font-family: var(--font-body);
    font-size: var(--font-size-label);
    font-weight: 400;
    color: var(--color-canvas-white);
    cursor: pointer;
    text-transform: lowercase;
    border-radius: var(--rounded-none);
    transition: background-color var(--duration-fast) var(--ease-out-expo), color var(--duration-fast) var(--ease-out-expo);
  }

  .hud-view-btn.is-active {
    background-color: var(--color-canvas-white);
    color: var(--color-canvas-black);
    font-weight: 500;
  }

  .hud-view-dot {
    font-size: var(--font-size-micro);
    line-height: 1;
  }

  /* Bottom-Left Telemetry & Route Suggestion */
  .hud-bottom-left {
    grid-column: 1;
    grid-row: 2;
    position: relative;
    align-self: flex-end;
    justify-self: flex-start;
    pointer-events: auto;
  }

  .hud-bottom-left-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-02);
  }

  .hud-telemetry {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--font-size-label);
    font-weight: 400;
    color: var(--color-text-secondary);
  }

  .hud-telemetry-num {
    color: var(--color-canvas-white);
    font-weight: 500;
  }

  .hud-suggest-link {
    font-family: var(--font-body);
    font-size: var(--font-size-micro);
    color: var(--color-text-secondary);
    text-decoration: none;
    text-transform: lowercase;
    display: inline-flex;
    width: fit-content;
    max-width: max-content;
    align-self: flex-start;
    transition: color var(--duration-fast) var(--ease-out-expo);
  }

  .hud-suggest-link:hover {
    color: var(--color-accent);
  }

  /* Bottom-Right Flight Board */
  .hud-bottom-right {
    grid-column: 2;
    grid-row: 2;
    align-self: flex-end;
    justify-self: flex-end;
    pointer-events: auto;
    width: 340px;
    max-width: calc(100vw - var(--space-08));
  }

  .flight-board-card {
    background-color: rgba(24, 19, 17, 0.88);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: var(--border-hairline);
    border-radius: var(--rounded-none);
    overflow: hidden;
  }

  .flight-board-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-03) var(--space-04);
    border-bottom: var(--border-hairline);
    background-color: rgba(255, 251, 249, 0.03);
  }

  .flight-board-status {
    display: flex;
    align-items: center;
    gap: var(--space-02);
  }

  .flight-board-pulse {
    color: var(--color-group-run-green);
    font-size: var(--font-size-micro);
    animation: pulseGlow 2s infinite ease-in-out;
  }

  @keyframes pulseGlow {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .flight-board-title {
    font-family: var(--font-body);
    font-size: var(--font-size-label);
    font-weight: 500;
    color: var(--color-canvas-white);
    text-transform: lowercase;
  }

  .flight-board-toggle {
    background: transparent;
    border: none;
    color: var(--color-text-secondary);
    font-size: var(--font-size-label);
    cursor: pointer;
    padding: var(--space-01) var(--space-02);
    line-height: 1;
  }

  .flight-board-toggle:hover {
    color: var(--color-canvas-white);
  }

  .flight-board-wrapper {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows var(--duration-moderate) var(--ease-out-expo), opacity var(--duration-moderate) var(--ease-out-expo);
  }

  .flight-board-card.is-minimized .flight-board-wrapper {
    grid-template-rows: 0fr;
    opacity: 0;
    pointer-events: none;
  }

  .flight-board-body {
    min-height: 0;
    max-height: 320px;
    overflow-y: auto;
  }

  .flight-board-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .flight-run-item {
    padding: var(--space-04);
    border-bottom: 1px solid rgba(255, 251, 249, 0.08);
    display: flex;
    flex-direction: column;
    gap: var(--space-02);
  }

  .flight-run-item:last-child {
    border-bottom: none;
  }

  .flight-run-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-body);
    font-size: var(--font-size-micro);
    color: var(--color-text-muted);
    text-transform: lowercase;
  }

  .flight-run-district {
    color: var(--color-accent);
  }

  .flight-run-main {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-02);
  }

  .flight-run-name {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--font-size-body);
    font-weight: 500;
    line-height: var(--leading-compressed);
    color: var(--color-canvas-white);
    text-transform: lowercase;
  }

  .flight-run-distance {
    font-family: var(--font-body);
    font-size: var(--font-size-label);
    color: var(--color-text-secondary);
    white-space: nowrap;
  }

  .flight-run-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: var(--space-01);
  }

  .flight-runner-badge {
    font-family: var(--font-body);
    font-size: var(--font-size-micro);
    color: var(--color-group-run-green);
    background-color: rgba(91, 190, 73, 0.12);
    padding: var(--space-01) var(--space-02);
    border-radius: var(--rounded-none);
    font-weight: 500;
  }

  .flight-focus-btn {
    background: transparent;
    border: none;
    font-family: var(--font-body);
    font-size: var(--font-size-micro);
    color: var(--color-text-secondary);
    cursor: pointer;
    padding: 0;
    transition: color var(--duration-fast) var(--ease-out-expo);
  }

  .flight-focus-btn:hover {
    color: var(--color-accent);
  }

  .flight-board-empty {
    padding: var(--space-05);
    text-align: center;
    font-family: var(--font-body);
    font-size: var(--font-size-label);
    color: var(--color-text-secondary);
  }

  /* Routes Catalogue Container */
  .routes-catalogue-view {
    width: 100%;
    background-color: var(--color-canvas-black);
    position: relative;
    z-index: 10;
  }

  .routes-catalogue-view[hidden] {
    display: none !important;
  }

  /* Grid View Mode Active State on HUD */
  .routes-hud.is-grid-active {
    position: sticky;
    top: var(--header-height);
    z-index: 25;
    height: auto;
    min-height: 0;
    display: flex;
    justify-content: flex-end;
    padding-block: var(--space-04);
    background-color: var(--color-canvas-black);
    border-bottom: var(--border-hairline);
    pointer-events: auto;
  }

  .routes-hud.is-grid-active .hud-top-left,
  .routes-hud.is-grid-active .hud-bottom-left,
  .routes-hud.is-grid-active .hud-bottom-right {
    display: none !important;
  }

  .routes-hud.is-grid-active .hud-top-right {
    position: static;
    display: flex;
    align-items: center;
    gap: var(--space-04);
    pointer-events: auto;
  }

  .hud-mobile-filter-trigger {
    display: none;
    background: transparent;
    border: var(--border-hairline);
    color: var(--color-canvas-white);
    font-family: var(--font-body);
    font-size: var(--font-size-label);
    padding: var(--space-02) var(--space-04);
    align-items: center;
    gap: var(--space-02);
    cursor: pointer;
  }

  .hud-filter-badge {
    background-color: var(--color-accent);
    color: var(--color-canvas-black);
    font-size: var(--font-size-micro);
    font-weight: 700;
    padding: var(--space-00) var(--space-02);
    line-height: 1.2;
  }

  /* Mobile Adaptation */
  @media (max-width: 768px) {
    .routes-hud {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: var(--space-04);
    }

    .hud-top-right {
      position: absolute;
      top: var(--space-04);
      right: var(--space-04);
    }

    .hud-bottom-left {
      margin-bottom: 72px; /* Avoid overlapping mobile bottom sheet peek */
    }

    .hud-bottom-right {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      width: 100%;
      max-width: 100%;
      z-index: 30;
    }

    .flight-board-card {
      border-left: none;
      border-right: none;
      border-bottom: none;
    }

    .routes-hud.is-grid-active {
      position: sticky;
      top: var(--header-height);
      z-index: 25;
      width: 100%;
      height: auto;
      padding: var(--space-03) var(--space-04);
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: flex-end;
    }

    .routes-hud.is-grid-active .hud-top-right {
      position: static;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .routes-hud.is-grid-active .hud-mobile-filter-trigger {
      display: inline-flex;
    }
  }
</style>

<script>
  function setupRoutesHud() {
    // 1. Difficulty selector buttons
    const diffButtons = document.querySelectorAll<HTMLButtonElement>('.hud-difficulty-btn');
    diffButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        diffButtons.forEach((b) => {
          b.classList.remove('is-active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('is-active');
        btn.setAttribute('aria-selected', 'true');

        const difficulty = btn.getAttribute('data-difficulty');
        window.dispatchEvent(new CustomEvent('routes:difficulty-changed', { detail: { difficulty } }));
      });
    });

    // 2. Map / Grid view toggle
    const mapToggleBtn = document.getElementById('view-toggle-map');
    const gridToggleBtn = document.getElementById('view-toggle-grid');
    const hudContainer = document.getElementById('routes-hud');
    const gridViewContainer = document.getElementById('routes-grid-view');

    function setView(view: 'map' | 'grid') {
      const viewport = document.getElementById('routes-viewport') || document.querySelector('.routes-viewport');
      const basemap = document.querySelector('.hk-basemap-container') as HTMLElement | null;

      if (view === 'grid') {
        gridToggleBtn?.classList.add('is-active');
        gridToggleBtn?.setAttribute('aria-pressed', 'true');
        mapToggleBtn?.classList.remove('is-active');
        mapToggleBtn?.setAttribute('aria-pressed', 'false');

        viewport?.classList.add('is-grid-active');
        hudContainer?.classList.add('is-grid-active');
        if (basemap) basemap.style.display = 'none';
        if (gridViewContainer) gridViewContainer.hidden = false;

        const url = new URL(window.location.href);
        url.searchParams.set('view', 'grid');
        window.history.replaceState(null, '', url.toString());
      } else {
        mapToggleBtn?.classList.add('is-active');
        mapToggleBtn?.setAttribute('aria-pressed', 'true');
        gridToggleBtn?.classList.remove('is-active');
        gridToggleBtn?.setAttribute('aria-pressed', 'false');

        viewport?.classList.remove('is-grid-active');
        hudContainer?.classList.remove('is-grid-active');
        if (basemap) basemap.style.display = '';
        if (gridViewContainer) gridViewContainer.hidden = true;

        const url = new URL(window.location.href);
        url.searchParams.delete('view');
        window.history.replaceState(null, '', url.toString());
      }
    }

    mapToggleBtn?.addEventListener('click', () => setView('map'));
    gridToggleBtn?.addEventListener('click', () => setView('grid'));

    // Check initial view from URL
    const initialUrl = new URL(window.location.href);
    if (initialUrl.searchParams.get('view') === 'grid') {
      setView('grid');
    }

    // 3. Flight board minimize / expand toggle
    const flightBoardToggle = document.getElementById('flight-board-toggle');
    const flightBoardCard = document.querySelector('.flight-board-card');

    flightBoardToggle?.addEventListener('click', () => {
      const isMinimized = flightBoardCard?.classList.toggle('is-minimized');
      flightBoardToggle.setAttribute('aria-expanded', isMinimized ? 'false' : 'true');
      const icon = flightBoardToggle.querySelector('.flight-toggle-icon');
      if (icon) icon.innerHTML = isMinimized ? '+' : '&minus;';
    });

    // 4. Focus on map clicks
    const focusButtons = document.querySelectorAll<HTMLButtonElement>('.flight-focus-btn');
    focusButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const slug = btn.getAttribute('data-route-slug');
        const district = btn.getAttribute('data-district');
        window.dispatchEvent(new CustomEvent('routes:focus-route', { detail: { slug, district } }));
      });
    });
  }

  // Initialize on page load and view transitions
  setupRoutesHud();
  document.addEventListener('astro:page-load', setupRoutesHud);
</script>
