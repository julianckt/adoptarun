---
import hkSvgData from '@/data/hk-basemap-svg.json';

export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`hk-basemap-container ${className}`} aria-hidden="true">
  <!-- Subtle Spatial Grid & Crosshairs Overlay -->
  <svg
    class="hk-basemap-svg"
    viewBox={hkSvgData.viewBox}
    preserveAspectRatio="xMidYMid meet"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <!-- Grid Crosshair Def -->
      <g id="crosshair">
        <path d="M-6,0 L6,0 M0,-6 L0,6" stroke="rgba(255, 251, 249, 0.12)" stroke-width="1" />
      </g>
    </defs>

    <!-- Geographic Lat/Lng Grid Lines -->
    <g class="hk-grid-lines">
      <!-- Horizontal Latitude Marks -->
      <line x1="0" y1="200" x2="1400" y2="200" stroke="rgba(255, 251, 249, 0.04)" stroke-width="1" stroke-dasharray="4 8" />
      <line x1="0" y1="450" x2="1400" y2="450" stroke="rgba(255, 251, 249, 0.04)" stroke-width="1" stroke-dasharray="4 8" />
      <line x1="0" y1="700" x2="1400" y2="700" stroke="rgba(255, 251, 249, 0.04)" stroke-width="1" stroke-dasharray="4 8" />

      <!-- Vertical Longitude Marks -->
      <line x1="350" y1="0" x2="350" y2="900" stroke="rgba(255, 251, 249, 0.04)" stroke-width="1" stroke-dasharray="4 8" />
      <line x1="700" y1="0" x2="700" y2="900" stroke="rgba(255, 251, 249, 0.04)" stroke-width="1" stroke-dasharray="4 8" />
      <line x1="1050" y1="0" x2="1050" y2="900" stroke="rgba(255, 251, 249, 0.04)" stroke-width="1" stroke-dasharray="4 8" />

      <!-- Coordinate Crosshairs -->
      <use href="#crosshair" x="350" y="200" />
      <use href="#crosshair" x="700" y="200" />
      <use href="#crosshair" x="1050" y="200" />
      <use href="#crosshair" x="350" y="450" />
      <use href="#crosshair" x="700" y="450" />
      <use href="#crosshair" x="1050" y="450" />
      <use href="#crosshair" x="350" y="700" />
      <use href="#crosshair" x="700" y="700" />
      <use href="#crosshair" x="1050" y="700" />
    </g>

    <!-- Pure Hong Kong Natural Coastline & Islands Outline (0 rivers, 0 roads) -->
    <path
      class="hk-coastline-outline"
      d={hkSvgData.coastlinePath}
      fill="none"
      stroke="rgba(255, 251, 249, 0.32)"
      stroke-width="1.3"
      stroke-linejoin="round"
      stroke-linecap="round"
    />

    <!-- Geographic Origin Watermark -->
    <text x="700" y="870" class="hk-origin-watermark" text-anchor="middle">
      HONG KONG SPATIAL TERRITORY · 22.3193° N, 114.1694° E
    </text>
  </svg>

  <!-- Centered Active Loading Spinner with Native Hardware-Accelerated SVG Rotation -->
  <div class="map-loading-indicator" aria-label="Loading territory radar">
    <svg class="map-spinner-svg" viewBox="0 0 40 40" width="36" height="36" aria-hidden="true">
      <circle cx="20" cy="20" r="16" fill="none" stroke="rgba(255, 251, 249, 0.14)" stroke-width="2.5" />
      <circle
        cx="20"
        cy="20"
        r="16"
        fill="none"
        stroke="var(--color-accent)"
        stroke-width="2.5"
        stroke-dasharray="28 72"
        stroke-linecap="round"
      >
        <animateTransform
          attributeName="transform"
          type="rotate"
          from="0 20 20"
          to="360 20 20"
          dur="0.9s"
          repeatCount="indefinite"
        />
      </circle>
    </svg>
    <span class="map-loading-text">loading territory radar...</span>
  </div>
</div>

<style>
  .hk-basemap-container {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background-color: var(--color-canvas-black);
    overflow: hidden;
    pointer-events: none;
    user-select: none;
  }

  .hk-basemap-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0.85;
  }

  .hk-origin-watermark {
    font-family: var(--font-body);
    font-size: var(--font-size-micro);
    font-weight: 500;
    letter-spacing: 0.2em;
    fill: var(--color-text-muted);
  }

  /* Centered Loading Indicator */
  .map-loading-indicator {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-03);
    z-index: 5;
    pointer-events: none;
  }

  .map-spinner-svg {
    display: block;
    transform-origin: center;
    animation: mapSpin 0.9s linear infinite;
  }

  .map-loading-text {
    font-family: var(--font-body);
    font-size: var(--font-size-micro);
    font-weight: 400;
    color: var(--color-text-muted);
    text-transform: lowercase;
    letter-spacing: 0.05em;
  }

  @keyframes mapSpin {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }
</style>
