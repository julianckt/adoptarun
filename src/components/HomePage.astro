---
/**
 * HomePage.astro
 *
 * Homepage body shared by the static public `/` (published content) and the on-demand
 * `/preview` route (drafts + stega for Studio Presentation), so the two can never drift apart.
 */
import AboutSection from '@/components/AboutSection.astro';
import JourneySection from '@/components/JourneySection.astro';
import FeaturedRoutesSection from '@/components/FeaturedRoutesSection.astro';
import CharitySection from '@/components/CharitySection.astro';
import BottomCtaSection from '@/components/BottomCtaSection.astro';
import RouteCard from '@/components/RouteCard.astro';
import ShaderBackgroundWrapper from '@/components/ShaderBackground/ShaderBackgroundWrapper.astro';
import type { SanityRoute, SanityCharity, SanitySiteCopy } from '@/sanity/types';
import { findSpotlightCharity, resolveTallyValues } from '@/utils/homepage-content';

import { selectFeaturedRoutes } from '@/utils/featured-routes';

export interface Props {
  routes: SanityRoute[] | null;
  charities: SanityCharity[] | null;
  siteCopy: SanitySiteCopy | null;
}

const { routes, charities, siteCopy } = Astro.props;

const heroRoutes = selectFeaturedRoutes(routes, 2);
const spcaCharity = findSpotlightCharity(charities);
const tally = resolveTallyValues(siteCopy);
const heroSubtitle = siteCopy?.heroSubtitle?.trim();
const heroDescription = siteCopy?.heroDescription?.trim();
---

<main>
  <!-- Shader lives inside <main> so main's clip-path confines the fixed layer (see .has-shader-bg > main) -->
  <ShaderBackgroundWrapper />
  <!-- Fullscreen Hero Section -->
  <section class="hero-fullscreen">
    <div class="hero-inner">
      <!-- Hero Section Main Row -->
      <div class="hero-main">
        <!-- Left Column: Wordmark & Tagline -->
        <div class="hero-header">
          <h1 class="c-wordmark c-wordmark--hero">
            <span class="c-wordmark-line"><span class="c-wordmark-adopt">adopt</span></span>
            <span class="c-wordmark-line"><span class="c-wordmark-a">a</span><span class="c-wordmark-space">&nbsp;</span><span class="c-wordmark-run">run</span></span>
          </h1>
          {heroSubtitle && <p class="hero-tagline">{heroSubtitle}</p>}
        </div>

        <!-- Right Column: Route Cards -->
        <div class="hero-cards">
          {heroRoutes.map((route) => (
            <RouteCard route={route} />
          ))}
        </div>
      </div>

      <!-- Hero Bottom Bar -->
      <div class="hero-bottom">
        {heroDescription && <p class="hero-mission">{heroDescription}</p>}
        <a href="#about-section" class="hero-learn-more" aria-label="Learn more about adopt a run">
          learn more &darr;
        </a>
      </div>
    </div>
  </section>

  <!-- Observer Seam: Future Routes Feature Section will activate Shader Preset B (add id="routes-featured") -->

  <!-- Homepage Curtain: Opaque container that reveals shader on transparent sections -->
  <div class="homepage-curtain">
    <!-- Homepage About Section (includes live community movement counters) -->
    <AboutSection {...tally} missionStatement={siteCopy?.missionStatement} />

    <!-- Section 03: 3-Step Caretaker Journey -->
    <JourneySection subtitle={siteCopy?.journeySubtitle} steps={siteCopy?.journeySteps} />
  </div>

  <!-- Section 04: Featured GPS Art Routes (Outside Curtain, transparent over Shader Preset B) -->
  <FeaturedRoutesSection routes={routes} />

  <!-- Secondary Curtain: Opaque Canvas Black Container for Charity Section -->
  <div class="homepage-curtain">
    <!-- Section 05: Partner Charities Spotlight (SPCA Feature) -->
    <CharitySection charity={spcaCharity} />
  </div>

  <!-- Section 06: Action Banner CTA (Outside Curtain, Transparent over Shader Preset A) -->
  <BottomCtaSection ctaDescription={siteCopy?.ctaDescription} />
</main>

<script>
  import { initScrollTimeline } from '@/utils/scroll-timeline-loader';

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => initScrollTimeline(), { once: true });
  } else {
    initScrollTimeline();
  }
</script>
