---
/**
 * StatsSection.astro
 *
 * Homepage Live Community Movement Counters section (Issue #6):
 * - Displays movement stats on a torn paper surface
 * - Numbers and units are masked with a continuous flowing gradient image backing
 * - Number values are isolated in `<span class="stat-value">` for future Sanity integration
 * - Torn paper backdrop stretches across full viewport width with a fixed height (crop behavior)
 *
 * All styles strictly comply with DESIGN.md and Lumos tokens.
 */
interface Props {
  totalKmCovered?: number | string;
  totalRunsCompleted?: number | string;
  totalParticipantsCount?: number | string;
  totalAmountRaised?: number | string;
}

const {
  totalKmCovered = '00',
  totalRunsCompleted = '00',
  totalParticipantsCount = '00',
  totalAmountRaised = '00',
} = Astro.props;
---

<section class="stats-section" aria-label="Live community movement counters">
  <div class="stats-paper-surface">
    <div class="stats-content">
      <div class="stats-row">
        <!-- 1: Distance -->
        <span class="stat-metric stat-metric-km">
          <span class="stat-value">{totalKmCovered}</span><span class="stat-space">&nbsp;</span><span class="stat-unit">km</span>
        </span>
        <span class="stat-connector stat-connector-covered">
          covered<br />across
        </span>

        <!-- 2: Runs Completed -->
        <span class="stat-metric stat-metric-runs">
          <span class="stat-value">{totalRunsCompleted}</span><span class="stat-space">&nbsp;</span><span class="stat-unit">runs</span>
        </span>
        <span class="stat-connector stat-connector-by">
          by
        </span>

        <!-- 3: Participants Count -->
        <span class="stat-metric stat-metric-participants">
          <span class="stat-value">{totalParticipantsCount}</span><span class="stat-space">&nbsp;</span><span class="stat-unit">participants</span>
        </span>
        <span class="stat-connector stat-connector-raising">
          raising
        </span>

        <!-- 4: Amount Raised -->
        <span class="stat-metric stat-metric-amount">
          <span class="stat-unit">$</span><span class="stat-value">{totalAmountRaised}</span>
        </span>
        <span class="stat-connector stat-connector-counting">
          and counting...
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  .stats-section {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    background-color: var(--color-canvas-black);
    overflow: hidden;
  }

  .stats-paper-surface {
    width: 100%;
    height: calc(var(--space-11) * 3); /* 240px fixed banner height */
    background-color: var(--color-canvas-white);
    -webkit-mask-image: url('/images/stats/torn-paper-mask.png');
    -webkit-mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-image: url('/images/stats/torn-paper-mask.png');
    mask-size: 100% 100%;
    mask-repeat: no-repeat;
    mask-position: center;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: var(--space-03);
    object-fit: fill;
  }

  .stats-content {
    width: 100%;
    max-width: 1416px;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .stats-row {
    display: flex;
    flex-direction: row;
    align-items: flex-end;
    justify-content: center;
    gap: var(--space-05);
    height: 51px;
    white-space: nowrap;
  }

  /* Metric numbers & units with continuous artwork backing */
  .stat-metric {
    display: inline-flex;
    align-items: baseline;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--font-size-title);
    line-height: var(--leading-compressed);
    background-image: url('/images/stats/stat-artwork.jpg');
    background-repeat: no-repeat;
    background-size: 1320px 240px;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  /* Horizontal artwork sampling positions across the 1320px track */
  .stat-metric-km {
    background-position: 5% center;
  }

  .stat-metric-runs {
    background-position: 28% center;
  }

  .stat-metric-participants {
    background-position: 55% center;
  }

  .stat-metric-amount {
    background-position: 85% center;
  }

  .stat-value {
    font-variant-numeric: tabular-nums;
  }

  .stat-unit {
    font-weight: 600;
  }

  .stat-space {
    font-size: var(--font-size-title);
  }

  /* Solid connector typography */
  .stat-connector {
    font-family: var(--font-display);
    font-weight: 400;
    color: var(--color-canvas-black);
    display: inline-block;
  }

  .stat-connector-covered {
    font-size: var(--font-size-body);
    line-height: var(--leading-compressed);
    text-align: right;
  }

  .stat-connector-by {
    font-size: var(--font-size-body);
    line-height: var(--leading-body);
    text-align: right;
  }

  .stat-connector-raising {
    font-size: var(--font-size-metric);
    line-height: var(--leading-body);
    text-align: right;
  }

  .stat-connector-counting {
    font-size: var(--font-size-metric);
    line-height: var(--leading-body);
    text-align: center;
  }
</style>
