---
/**
 * CharitySection.astro
 *
 * Section 05: Partner Charities Spotlight (SPCA Feature) (Issue #6):
 * - Natural unpinned document flow with standard Lumos section footprint.
 * - Decoupled trigger-once animations for header ("Proudly Supporting") and footer text/CTA
 *   using authentic AboutSection drift curve (600ms cubic-bezier(0.16, 1, 0.3, 1)).
 * - Centerpiece retains real-time natural scroll scrub: Overlapping photo frame scales up
 *   faster than letters part.
 * - Sourced from Sanity getCharities() with graceful static fallback.
 * - Fully compliant with DESIGN.md zero-radius rule and Lumos tokens.
 */
import type { SanityCharity } from '@/sanity/types';

export interface Props {
  charity?: SanityCharity | null;
  class?: string;
  [key: string]: any;
}

const { charity, class: className, ...restProps } = Astro.props;

const charityTitle = 'Proudly Supporting';
const charityName = charity?.name || 'SPCA';
const charityDescription =
  charity?.charityDescription ||
  'The Society for the Prevention of Cruelty to Animals (SPCA) champions the welfare of all animals in Hong Kong. By adopting our animal-shaped GPS art routes, every kilometer you run raises awareness, rescue funds, and compassionate community support for shelter animals in need.';
---

<section id="charity-spotlight" class:list={['charity-section', className]} aria-label="Partner Charities Spotlight - SPCA" {...restProps}>
  <div class="charity-container">
    <!-- Section Header (Trigger-Once Entrance) -->
    <header id="charity-header" class="charity-header">
      <h2 class="charity-subtitle">{charityTitle}</h2>
    </header>

    <!-- Centerpiece: Overlapping SPCA typography with expanding central framed photo -->
    <div class="charity-centerpiece" aria-label={`${charityName} Spotlight`}>
      <!-- Left letter block: SP -->
      <span class="charity-letter charity-letter--left" aria-hidden="true">SP</span>

      <!-- Expanding central photo frame overlapping SP and CA -->
      <div class="charity-photo-frame" role="img" aria-label="SPCA rescue puppy resting head gently in human hand">
        <img
          src="/images/charity/spca-puppy.jpg"
          alt="SPCA rescue puppy resting head in human hand"
          class="charity-photo-img"
          width="568"
          height="379"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Right letter block: CA -->
      <span class="charity-letter charity-letter--right" aria-hidden="true">CA</span>
    </div>

    <!-- Bottom Mission Copy & Action Link (Trigger-Once Entrance) -->
    <footer id="charity-footer" class="charity-footer">
      <p class="charity-description">
        {charityDescription}
      </p>
      <div class="charity-actions">
        <a href="/charities" class="hairline-link hairline-link--orange charity-cta-link" aria-label="View all partner charities">
          view all partner charities &rarr;
        </a>
      </div>
    </footer>
  </div>
</section>

<style>
  .charity-section {
    width: 100%;
    background-color: var(--color-canvas-black);
    position: relative;
    overflow: hidden;
    padding-top: var(--space-12);
    padding-bottom: var(--space-12);
    box-sizing: border-box;
    /* CSS variables driven by JavaScript natural scroll scrub */
    --scroll-progress: 0;
    --photo-scale: 0.72;
    --letter-split: 0px;
  }

  .charity-container {
    width: 100%;
    max-width: 1512px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-left: var(--space-06);
    padding-right: var(--space-06);
    box-sizing: border-box;
    position: relative;
  }

  /* Section Header: Trigger-once fade and upward drift (AboutSection curve) */
  .charity-header {
    width: 100%;
    text-align: center;
    margin-bottom: var(--space-08);
    opacity: 0;
    transform: translateY(var(--space-06));
    transition: opacity 600ms cubic-bezier(0.16, 1, 0.3, 1),
                transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .charity-header.is-triggered {
    opacity: 1;
    transform: translateY(var(--space-00));
  }

  .charity-subtitle {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--font-size-hero-wordmark);
    line-height: var(--leading-default);
    color: var(--color-canvas-white);
    margin: 0;
    padding: 0;
    letter-spacing: -0.02em;
  }

  /* Overlapping Split Centerpiece */
  .charity-centerpiece {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    user-select: none;
    margin-bottom: var(--space-08);
  }

  .charity-letter {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--font-fluid-colossal);
    line-height: var(--leading-default);
    color: var(--color-canvas-white);
    display: inline-block;
    position: relative;
    z-index: 1;
    will-change: transform;
    transition: transform 0.05s linear;
  }

  .charity-letter--left {
    transform: translateX(calc(-1 * var(--letter-split, 0px)));
  }

  .charity-letter--right {
    transform: translateX(var(--letter-split, 0px));
  }

  /* Expanding Overlapping Photo Frame */
  .charity-photo-frame {
    width: min(568px, 38vw);
    height: min(379px, 25.3vw);
    position: relative;
    z-index: 2;
    flex-shrink: 0;
    overflow: hidden;
    border-radius: var(--radius-none);
    background-color: var(--color-surface-canvas);
    /* Negative horizontal margin creates authentic overlap across SP and CA */
    margin-left: calc(-1 * clamp(24px, 3.5vw, 56px));
    margin-right: calc(-1 * clamp(24px, 3.5vw, 56px));
    box-shadow: 0 var(--space-06) var(--space-12) rgba(0, 0, 0, 0.7);
    will-change: transform;
    transform: scale(var(--photo-scale, 0.72));
    transition: transform 0.05s linear;
  }

  .charity-photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    display: block;
    /* Subtle counter-zoom to deepen parallax inside frame */
    transform: scale(calc(1.12 - (var(--photo-scale, 0.72) - 0.72) * 0.25));
    transition: transform 0.05s linear;
  }

  /* Bottom Copy & Link: Trigger-once fade and upward drift (AboutSection curve) */
  .charity-footer {
    width: 100%;
    max-width: 960px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .charity-description {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--font-size-label);
    line-height: var(--leading-body);
    color: var(--color-canvas-white);
    margin: 0 0 var(--space-04) 0;
    padding: 0;
    max-width: 880px;
    opacity: 0;
    transform: translateY(var(--space-06));
    transition: opacity 600ms cubic-bezier(0.16, 1, 0.3, 1),
                transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .charity-actions {
    display: flex;
    justify-content: center;
    opacity: 0;
    transform: translateY(var(--space-06));
    transition: opacity 600ms cubic-bezier(0.16, 1, 0.3, 1),
                transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: 150ms;
  }

  /* Triggered state for footer description and action link */
  .charity-footer.is-triggered .charity-description,
  .charity-footer.is-triggered .charity-actions {
    opacity: 1;
    transform: translateY(var(--space-00));
  }

  /* Reduced Motion Accessibility */
  @media (prefers-reduced-motion: reduce) {
    .charity-section {
      --scroll-progress: 1 !important;
      --photo-scale: 1 !important;
      --letter-split: 40px !important;
    }

    .charity-header,
    .charity-description,
    .charity-actions {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }

    .charity-letter,
    .charity-photo-frame,
    .charity-photo-img {
      transform: none !important;
      transition: none !important;
    }

    .charity-photo-frame {
      transform: scale(1) !important;
    }
  }
</style>

<script>
  function initCharityComponent() {
    const section = document.getElementById('charity-spotlight');
    const header = document.getElementById('charity-header');
    const footer = document.getElementById('charity-footer');

    if (!section) return;

    // Reduced motion shortcut
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      header?.classList.add('is-triggered');
      footer?.classList.add('is-triggered');
      section.style.setProperty('--scroll-progress', '1');
      section.style.setProperty('--photo-scale', '1');
      section.style.setProperty('--letter-split', '40px');
      return;
    }

    // 1. Trigger-once entrance for Header & Footer via IntersectionObserver
    if ('IntersectionObserver' in window) {
      const headerObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              header?.classList.add('is-triggered');
              headerObserver.unobserve(entry.target);
            }
          });
        },
        {
          threshold: 0.05,
          rootMargin: '0px 0px -40px 0px',
        }
      );

      const footerObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              footer?.classList.add('is-triggered');
              footerObserver.unobserve(entry.target);
            }
          });
        },
        {
          threshold: 0.1,
          rootMargin: '0px 0px -40px 0px',
        }
      );

      if (header) headerObserver.observe(header);
      if (footer) footerObserver.observe(footer);
    } else {
      header?.classList.add('is-triggered');
      footer?.classList.add('is-triggered');
    }

    // 2. Real-time natural scroll scrub for Centerpiece (photo expansion & letter split)
    let isTicking = false;

    function updateCenterpieceScrub() {
      if (!section) return;
      const rect = section.getBoundingClientRect();
      const viewportHeight = window.innerHeight;

      // Progress from entrance to center of viewport
      const sectionCenter = rect.top + rect.height * 0.5;
      const startY = viewportHeight * 1.1;
      const targetCenterY = viewportHeight * 0.55;

      const distance = startY - targetCenterY;
      const current = startY - sectionCenter;
      const rawProgress = current / distance;
      const progress = Math.max(0, Math.min(1, rawProgress));

      // Accelerated power curve (0.65) for photo scaling
      const photoCurve = Math.pow(progress, 0.65);
      const photoScale = 0.72 + photoCurve * 0.38;

      // Steadier curve (1.2) for letter split
      const letterCurve = Math.pow(progress, 1.2);
      const maxSplitPx = Math.min(56, Math.max(24, window.innerWidth * 0.035));
      const letterSplit = (letterCurve * maxSplitPx).toFixed(2) + 'px';

      section.style.setProperty('--scroll-progress', progress.toFixed(4));
      section.style.setProperty('--photo-scale', photoScale.toFixed(4));
      section.style.setProperty('--letter-split', letterSplit);

      isTicking = false;
    }

    function onScroll() {
      if (!isTicking) {
        requestAnimationFrame(updateCenterpieceScrub);
        isTicking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    updateCenterpieceScrub();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCharityComponent);
  } else {
    initCharityComponent();
  }
</script>
