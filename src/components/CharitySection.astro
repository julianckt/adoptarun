---
/**
 * CharitySection.astro
 *
 * Section 05: Partner Charities Spotlight (SPCA Feature) (Issue #6):
 * - Natural unpinned document flow framed by top and bottom hairlines.
 * - Centerpiece is a smoothed scroll scrub: the photo frame grows ahead of the letters and
 *   its moving edges push SP and CA aside; the letters trail slightly for a sense of weight.
 * - Header and footer text reveal on a triggered, fixed-duration fade (rise + blur-to-sharp).
 *   The trigger fires both ways: text reveals on entering the viewport from either direction
 *   and resets on leaving, so it replays every pass.
 * - CSS defaults are the settled end state, so no-JS and reduced-motion show the final layout.
 * - Sourced from Sanity getCharities() with graceful static fallback.
 * - Fully compliant with DESIGN.md zero-radius rule and Lumos tokens.
 */
import type { SanityCharity } from '@/sanity/types';
import { resolveCharityPhoto } from '@/utils/homepage-content';

export interface Props {
  charity?: SanityCharity | null;
  class?: string;
  [key: string]: any;
}

const { charity, class: className, ...restProps } = Astro.props;

const charityTitle = 'Proudly Supporting';
const charityDescription = charity?.charityDescription;
const photo = resolveCharityPhoto(charity);
---

<section id="charity-spotlight" class:list={['charity-section', className]} aria-labelledby="charity-heading" {...restProps}>
  <div class="charity-container page-frame">
    <!-- Section Header (Triggered reveal) -->
    <header id="charity-header" class="charity-header" data-charity-reveal>
      <!-- The SP/CA letters are aria-hidden, so the name is announced once, here -->
      <h2 id="charity-heading" class="charity-subtitle">{charityTitle} <span class="visually-hidden">SPCA</span></h2>
    </header>

    <!-- Centerpiece: Overlapping SPCA typography with expanding central framed photo -->
    <div class="charity-centerpiece">
      <!-- Left letter block: SP -->
      <span class="charity-letter charity-letter--left" aria-hidden="true">SP</span>

      <!-- Expanding central photo frame overlapping SP and CA -->
      <div class="charity-photo-frame">
        <img
          src={photo.src}
          alt={photo.alt}
          class="charity-photo-img"
          width="568"
          height="379"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Right letter block: CA -->
      <span class="charity-letter charity-letter--right" aria-hidden="true">CA</span>
    </div>

    <!-- Bottom Mission Copy & Action Link (Triggered reveal) -->
    <footer id="charity-footer" class="charity-footer">
      <p class="charity-description" data-charity-reveal>
        {charityDescription}
      </p>
      <div class="charity-actions" data-charity-reveal>
        <a href="/charities" class="hairline-link hairline-link--orange charity-cta-link">
          view all partner charities &rarr;
        </a>
      </div>
    </footer>
  </div>
</section>

<style>
  .charity-section {
    width: 100%;
    background-color: var(--color-canvas-black);
    position: relative;
    overflow: hidden;
    padding-top: var(--space-12);
    padding-bottom: var(--space-12);
    border-top: 1px solid var(--color-border-hairline);
    border-bottom: 1px solid var(--color-border-hairline);
    box-sizing: border-box;
    /* Settled end state; JavaScript scrubs these while the section is in view */
    --photo-scale: 1;
    --letter-split: 0px;
  }

  .charity-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  /* Triggered reveal: the script toggles .is-revealed as each element crosses the trigger line */
  [data-charity-reveal] {
    transition: opacity var(--duration-moderate) var(--ease-out-expo),
                transform var(--duration-moderate) var(--ease-out-expo),
                filter var(--duration-moderate) var(--ease-out-expo);
    transition-delay: var(--reveal-delay, 0ms);
  }

  .charity-actions {
    --reveal-delay: 80ms;
  }

  /* Hidden state only applies once the script arms the section, so no-JS shows everything */
  :global(.charity-section.is-armed) [data-charity-reveal]:not(.is-revealed) {
    opacity: 0;
    transform: translateY(var(--space-04));
    filter: blur(calc(var(--space-01) / 2));
  }

  .charity-header {
    width: 100%;
    text-align: center;
    margin-bottom: var(--space-10);
  }

  .charity-subtitle {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--font-fluid-title);
    line-height: var(--leading-default);
    color: var(--color-text-secondary);
    margin: 0;
    padding: 0;
    letter-spacing: -0.02em;
  }

  /* Overlapping Split Centerpiece */
  .charity-centerpiece {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    user-select: none;
    margin-bottom: var(--space-10);
  }

  .charity-letter {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: calc(var(--font-fluid-colossal) * 0.77);
    line-height: var(--leading-default);
    color: var(--color-art-cyan);
    display: inline-block;
    position: relative;
    z-index: 1;
    will-change: transform;
  }

  .charity-letter--left {
    transform: translateX(calc(-1 * var(--letter-split, 0px)));
  }

  .charity-letter--right {
    transform: translateX(var(--letter-split, 0px));
  }

  /* Expanding Overlapping Photo Frame */
  .charity-photo-frame {
    width: calc(min(568px, 38vw) * 0.77);
    height: calc(min(379px, 25.3vw) * 0.77);
    position: relative;
    z-index: 2;
    flex-shrink: 0;
    overflow: hidden;
    background-color: var(--color-surface-canvas);
    /* Negative horizontal margin creates authentic overlap across SP and CA */
    margin-left: calc(-0.77 * clamp(24px, 3.5vw, 56px));
    margin-right: calc(-0.77 * clamp(24px, 3.5vw, 56px));
    box-shadow: 0 var(--space-06) var(--space-12) rgba(0, 0, 0, 0.7);
    will-change: transform;
    transform: scale(var(--photo-scale, 1));
  }

  .charity-photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    display: block;
    /* Counter-zoom: image sits slightly closer while the frame is small, settles as it opens */
    transform: scale(calc(1 + (1 - var(--photo-scale, 1)) * 0.4));
  }

  .charity-footer {
    width: 100%;
    max-width: 960px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .charity-description {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--font-size-label);
    line-height: var(--leading-body);
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-06) 0;
    padding: 0;
    max-width: 880px;
  }

  .charity-actions {
    display: flex;
    justify-content: center;
  }

  /* Small screens: the split turns vertical. SP sits above the photo and CA below, and the
     growing photo pushes them up and down instead of sideways (the script measures height here). */
  @media (max-width: 640px) {
    .charity-section {
      padding-top: var(--space-10);
      padding-bottom: var(--space-10);
    }

    .charity-header,
    .charity-centerpiece {
      margin-bottom: var(--space-08);
    }

    .charity-centerpiece {
      flex-direction: column;
    }

    .charity-letter {
      font-size: 46vw;
      /* Trim the line box to the capitals so SP and CA sit tight against the photo */
      line-height: var(--leading-display);
    }

    .charity-letter--left {
      transform: translateY(calc(-1 * var(--letter-split, 0px)));
    }

    .charity-letter--right {
      transform: translateY(var(--letter-split, 0px));
    }

    .charity-photo-frame {
      width: 72vw;
      height: 48vw;
      /* Top overlaps SP, bottom overlaps CA (CA tucks further behind the photo) */
      margin: -11vw 0 -15vw;
    }
  }

  /* Reduced Motion: script never runs, so the settled defaults above apply */
  @media (prefers-reduced-motion: reduce) {
    [data-charity-reveal] {
      transition: none;
    }

    .charity-letter,
    .charity-photo-frame,
    .charity-photo-img {
      will-change: auto;
    }
  }
</style>

<script>
  function initCharityComponent() {
    const section = document.getElementById('charity-spotlight');
    const frame = section?.querySelector<HTMLElement>('.charity-photo-frame');
    if (!section || !frame) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    // Text reveals fire on entry from either direction and reset on exit, so they replay every pass.
    // The trigger line sits 15% above the viewport bottom.
    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => entry.target.classList.toggle('is-revealed', entry.isIntersecting));
      },
      { rootMargin: '0px 0px -5% 0px', threshold: 0 }
    );
    section.querySelectorAll('[data-charity-reveal]').forEach((el) => revealObserver.observe(el));
    section.classList.add('is-armed');

    // Photo scale at the start of the scrub; it reaches 1 at 75% of the scroll range.
    const PHOTO_START = 0.62;
    const PHOTO_LEAD = 0.75;
    // Per-frame approach rates (at 60fps). Letters are slower than the photo so they trail its edges.
    const PHOTO_RATE = 0.102;
    const LETTER_RATE = 0.072;

    const clamp01 = (v: number) => Math.min(1, Math.max(0, v));
    const easeOutCubic = (t: number) => 1 - Math.pow(1 - t, 3);
    const approach = (current: number, target: number, rate: number, dt: number) =>
      current + (target - current) * (1 - Math.pow(1 - rate, dt / (1000 / 60)));

    // Below 640px the split is vertical, so the photo pushes along its height instead of its width
    const verticalQuery = window.matchMedia('(max-width: 640px)');
    const measureFrame = () => (verticalQuery.matches ? frame.offsetHeight : frame.offsetWidth);
    let frameSize = measureFrame();

    function readTargets() {
      const vh = window.innerHeight;
      const rect = section!.getBoundingClientRect();

      // Centerpiece progress: section centre travels from 110% to ~41% of the viewport
      const startY = vh * 1.1;
      const endY = vh * 0.4125;
      const progress = clamp01((startY - (rect.top + rect.height * 0.5)) / (startY - endY));
      const photo = PHOTO_START + (1 - PHOTO_START) * easeOutCubic(clamp01(progress / PHOTO_LEAD));

      return { photo };
    }

    // Letters hug the photo's visual edge: a scaled frame's edge moves by size * (scale - 1) / 2
    const edgeFor = (photoScale: number) => (frameSize * (photoScale - 1)) / 2;

    const initial = readTargets();
    const state = {
      photo: initial.photo,
      split: edgeFor(initial.photo),
    };

    function write() {
      section!.style.setProperty('--photo-scale', state.photo.toFixed(4));
      section!.style.setProperty('--letter-split', state.split.toFixed(2) + 'px');
    }

    write();

    let running = false;
    let lastTime = 0;

    function step(now: number) {
      const dt = lastTime ? Math.min(64, now - lastTime) : 1000 / 60;
      lastTime = now;

      const targets = readTargets();
      state.photo = approach(state.photo, targets.photo, PHOTO_RATE, dt);
      const edge = edgeFor(state.photo);
      state.split = approach(state.split, edge, LETTER_RATE, dt);
      write();

      const settled =
        Math.abs(state.photo - targets.photo) < 0.0005 && Math.abs(state.split - edge) < 0.1;

      if (settled) {
        running = false;
        lastTime = 0;
      } else {
        requestAnimationFrame(step);
      }
    }

    function kick() {
      if (running) return;
      running = true;
      requestAnimationFrame(step);
    }

    window.addEventListener('scroll', kick, { passive: true });
    window.addEventListener(
      'resize',
      () => {
        frameSize = measureFrame();
        kick();
      },
      { passive: true }
    );
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCharityComponent);
  } else {
    initCharityComponent();
  }
</script>
