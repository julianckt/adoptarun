---
/**
 * CharitySection.astro
 *
 * Section 05: Partner Charities Spotlight (SPCA Feature) (Issue #6):
 * - Natural unpinned document flow with standard Lumos section footprint.
 * - Center-weighted scroll scrub: Animation runs smoothly as the section travels from viewport
 *   entrance to screen center.
 * - Overlapping layout: Central photo sits on top (z-index: 2), overlapping the inner edges
 *   of "SP" and "CA".
 * - Differential dynamics: Photo scales up faster than the letters move aside.
 * - Fully compliant with DESIGN.md zero-radius rule and Lumos tokens.
 */
import { getCharities } from '@/sanity/queries';
import type { SanityCharity } from '@/sanity/types';

let spcaCharity: SanityCharity | undefined;
try {
  const charities = await getCharities();
  spcaCharity = charities?.find(
    (c) => c.slug?.current?.includes('spca') || c.name?.toLowerCase().includes('spca')
  ) || charities?.[0];
} catch {
  // Graceful fallback if network or Sanity client unavailable
}

const charityTitle = 'Proudly Supporting';
const charityName = spcaCharity?.name || 'SPCA';
const charityDescription =
  spcaCharity?.charityDescription ||
  'The Society for the Prevention of Cruelty to Animals (SPCA) champions the welfare of all animals in Hong Kong. By adopting our animal-shaped GPS art routes, every kilometer you run raises awareness, rescue funds, and compassionate community support for shelter animals in need.';
---

<section id="charity-spotlight" class="charity-section" aria-label="Partner Charities Spotlight - SPCA">
  <div class="charity-container">
    <!-- Section Header -->
    <header class="charity-header charity-fade-element">
      <h2 class="charity-subtitle">{charityTitle}</h2>
    </header>

    <!-- Centerpiece: Overlapping SPCA typography with expanding central framed photo -->
    <div class="charity-centerpiece" aria-label={`${charityName} Spotlight`}>
      <!-- Left letter block: SP -->
      <span class="charity-letter charity-letter--left" aria-hidden="true">SP</span>

      <!-- Expanding central photo frame overlapping SP and CA -->
      <div class="charity-photo-frame" role="img" aria-label="SPCA rescue puppy resting head gently in human hand">
        <img
          src="/images/charity/spca-puppy.jpg"
          alt="SPCA rescue puppy resting head in human hand"
          class="charity-photo-img"
          width="568"
          height="379"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Right letter block: CA -->
      <span class="charity-letter charity-letter--right" aria-hidden="true">CA</span>
    </div>

    <!-- Bottom Mission Copy & Action Link -->
    <footer class="charity-footer charity-fade-element">
      <p class="charity-description">
        {charityDescription}
      </p>
      <div class="charity-actions">
        <a href="/charities" class="charity-cta-link" aria-label="View all partner charities">
          view all partner charities &rarr;
        </a>
      </div>
    </footer>
  </div>
</section>

<style>
  .charity-section {
    width: 100%;
    background-color: var(--color-canvas-black);
    position: relative;
    overflow: hidden;
    padding-top: var(--space-12);
    padding-bottom: var(--space-12);
    box-sizing: border-box;
    /* CSS variables driven by JavaScript natural scroll scrub */
    --scroll-progress: 0;
    --fade-progress: 0;
    --photo-scale: 0.72;
    --letter-split: 0px;
  }

  .charity-container {
    width: 100%;
    max-width: 1512px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-left: var(--space-06);
    padding-right: var(--space-06);
    box-sizing: border-box;
    position: relative;
  }

  /* Section Header */
  .charity-header {
    width: 100%;
    text-align: center;
    margin-bottom: var(--space-08);
  }

  .charity-subtitle {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--font-size-hero-wordmark);
    line-height: var(--leading-default);
    color: var(--color-canvas-white);
    margin: 0;
    padding: 0;
    letter-spacing: -0.02em;
  }

  /* Overlapping Split Centerpiece */
  .charity-centerpiece {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    user-select: none;
    margin-bottom: var(--space-08);
  }

  .charity-letter {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--font-fluid-colossal);
    line-height: var(--leading-default);
    color: var(--color-canvas-white);
    display: inline-block;
    position: relative;
    z-index: 1;
    will-change: transform, opacity;
    opacity: calc(0.2 + 0.8 * var(--fade-progress, 0));
    transition: transform 0.05s linear;
  }

  .charity-letter--left {
    transform: translateX(calc(-1 * var(--letter-split, 0px)));
  }

  .charity-letter--right {
    transform: translateX(var(--letter-split, 0px));
  }

  /* Expanding Overlapping Photo Frame */
  .charity-photo-frame {
    width: min(568px, 38vw);
    height: min(379px, 25.3vw);
    position: relative;
    z-index: 2;
    flex-shrink: 0;
    overflow: hidden;
    border-radius: var(--radius-none);
    background-color: var(--color-surface-canvas);
    /* Negative horizontal margin creates the authentic overlap across SP and CA */
    margin-left: calc(-1 * clamp(24px, 3.5vw, 56px));
    margin-right: calc(-1 * clamp(24px, 3.5vw, 56px));
    box-shadow: 0 var(--space-06) var(--space-12) rgba(0, 0, 0, 0.7);
    will-change: transform, opacity;
    transform: scale(var(--photo-scale, 0.72));
    opacity: calc(0.25 + 0.75 * var(--fade-progress, 0));
    transition: transform 0.05s linear;
  }

  .charity-photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    display: block;
    /* Subtle counter-zoom to deepen parallax inside frame */
    transform: scale(calc(1.12 - (var(--photo-scale, 0.72) - 0.72) * 0.25));
    transition: transform 0.05s linear;
  }

  /* Bottom Copy & Link */
  .charity-footer {
    width: 100%;
    max-width: 960px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .charity-description {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--font-size-label);
    line-height: var(--leading-body);
    color: var(--color-canvas-white);
    margin: 0 0 var(--space-04) 0;
    padding: 0;
    max-width: 880px;
  }

  .charity-actions {
    display: flex;
    justify-content: center;
  }

  .charity-cta-link {
    font-family: var(--font-body);
    font-size: var(--font-size-label);
    line-height: var(--leading-action);
    font-weight: 500;
    color: var(--color-route-orange);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: var(--space-02);
    padding: var(--space-02) var(--space-04);
    border-radius: var(--radius-none);
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .charity-cta-link:hover,
  .charity-cta-link:focus-visible {
    color: var(--color-pure-white);
    transform: translateX(var(--space-01));
    outline: none;
  }

  /* Fade Element Staging */
  .charity-fade-element {
    will-change: opacity, transform;
    opacity: calc(0.1 + 0.9 * var(--fade-progress, 0));
    transform: translateY(calc((1 - var(--fade-progress, 0)) * 16px));
  }

  /* Reduced Motion Accessibility */
  @media (prefers-reduced-motion: reduce) {
    .charity-section {
      --scroll-progress: 1 !important;
      --fade-progress: 1 !important;
      --photo-scale: 1 !important;
      --letter-split: 40px !important;
    }

    .charity-letter,
    .charity-photo-frame,
    .charity-photo-img,
    .charity-fade-element {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }

    .charity-photo-frame {
      transform: scale(1) !important;
    }
  }
</style>

<script>
  function initCharityNaturalScroll() {
    const section = document.getElementById('charity-spotlight');
    if (!section) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      section.style.setProperty('--scroll-progress', '1');
      section.style.setProperty('--fade-progress', '1');
      section.style.setProperty('--photo-scale', '1');
      section.style.setProperty('--letter-split', '40px');
      return;
    }

    let isTicking = false;

    function updateProgress() {
      if (!section) return;
      const rect = section.getBoundingClientRect();
      const viewportHeight = window.innerHeight;

      // Centerpiece target: reaches 100% when section center arrives near viewport center
      const sectionCenter = rect.top + rect.height * 0.5;
      const startY = viewportHeight * 1.1; // starts slightly before entering bottom
      const targetCenterY = viewportHeight * 0.55; // full expansion at eye-level center

      const distance = startY - targetCenterY;
      const current = startY - sectionCenter;
      const rawProgress = current / distance;
      const progress = Math.max(0, Math.min(1, rawProgress));

      // 1. Text fade-in: fast entrance over first 35% of progress
      const fadeProgress = Math.max(0, Math.min(1, progress / 0.35));

      // 2. Photo scaling: accelerated power curve (0.65 exponent) for faster scaling
      const photoCurve = Math.pow(progress, 0.65);
      const photoScale = 0.72 + photoCurve * 0.38; // scales from 0.72 to 1.10

      // 3. Letter split: steadier rate (1.2 exponent)
      const letterCurve = Math.pow(progress, 1.2);
      // Maximum split in pixels (capped proportionally)
      const maxSplitPx = Math.min(56, Math.max(24, window.innerWidth * 0.035));
      const letterSplit = (letterCurve * maxSplitPx).toFixed(2) + 'px';

      section.style.setProperty('--scroll-progress', progress.toFixed(4));
      section.style.setProperty('--fade-progress', fadeProgress.toFixed(4));
      section.style.setProperty('--photo-scale', photoScale.toFixed(4));
      section.style.setProperty('--letter-split', letterSplit);

      isTicking = false;
    }

    function onScroll() {
      if (!isTicking) {
        requestAnimationFrame(updateProgress);
        isTicking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    updateProgress();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCharityNaturalScroll);
  } else {
    initCharityNaturalScroll();
  }
</script>
