---
/**
 * JourneySection.astro
 *
 * Section 03: 3-Step Caretaker Journey (Issue #6):
 * - Displays the 3 steps to adopting a run (Match & Commit, Grow & Nurture, Forever Guardian).
 * - Split layout: masthead (mesh-backdrop "3" + STEPS TO wordmark lockup + mission) on the left,
 *   the 3 steps as a hairline-ruled ledger on the right. Stacks to one column below 1100px.
 * - Connected stepper: each rule carries a square waypoint node and a Route Orange trace.
 *
 * Scroll storytelling (CSS scroll-driven, no JS): the mesh badge wipes open, then each step's
 * trace draws along its rule from the node while its text rises out of a soft blur. Defaults
 * are the settled end state, so unsupported browsers and reduced motion show the final layout.
 *
 * All styles strictly comply with DESIGN.md and Lumos tokens.
 */
---

<section id="journey-section" class="journey-section" aria-labelledby="journey-heading">
  <div class="journey-container">
    <header class="journey-masthead">
      <h2 id="journey-heading" class="journey-lockup" aria-label="3 steps to adopt a run">
        <span class="journey-badge-square" aria-hidden="true">
          <span class="journey-badge-number">3</span>
        </span>
        <span class="journey-heading-lockup" aria-hidden="true">
          <span class="journey-lead-text">STEPS TO</span>
          <span class="c-wordmark c-wordmark--headline journey-wordmark">
            <span class="c-wordmark-line"><span class="c-wordmark-adopt">adopt</span></span>
            <span class="c-wordmark-line"><span class="c-wordmark-a">a</span><span class="c-wordmark-space">&nbsp;</span><span class="c-wordmark-run">run</span></span>
          </span>
        </span>
      </h2>
      <p class="journey-mission-text">make commitments to yourself and to your community – run the route and own the impact</p>
    </header>

    <ol class="journey-list">
      <li class="journey-step">
        <span class="journey-step-numeral">one.</span>
        <h3 class="journey-step-title">match+<br />commit</h3>
        <p class="journey-step-desc">match with an animal route, and choose a charity cause to pair with and commit to</p>
      </li>
      <li class="journey-step">
        <span class="journey-step-numeral">two.</span>
        <h3 class="journey-step-title">grow+<br />nurture</h3>
        <p class="journey-step-desc">bring your animal to life with your running steps and fundraise to nurture your cause</p>
      </li>
      <li class="journey-step">
        <span class="journey-step-numeral">three.</span>
        <h3 class="journey-step-title">forever<br />guardian</h3>
        <p class="journey-step-desc">own your success in running and in impact! Hand off your run to its next caretaker</p>
      </li>
    </ol>
  </div>
</section>

<style>
  .journey-section {
    width: 100%;
    background-color: var(--color-canvas-black);
    position: relative;
    z-index: 10;
  }

  /* Shares About's frame and gutters so the two sections read as one run of content */
  .journey-container {
    width: 100%;
    max-width: 1512px;
    margin: 0 auto;
    padding-block: var(--space-fluid-xl) var(--space-fluid-3xl);
    padding-inline: var(--space-fluid-xl);
    box-sizing: border-box;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-fluid-2xl);
    align-items: start;
    color: var(--color-canvas-white);
  }

  /* Masthead */
  .journey-masthead {
    display: flex;
    flex-direction: column;
    gap: var(--space-07);
    min-width: 0;
    view-timeline: --journey-masthead block;
  }

  .journey-lockup {
    display: flex;
    align-items: flex-end;
    gap: var(--space-06);
    margin: 0;
    font-weight: inherit;
  }

  .journey-badge-square {
    width: var(--space-13);
    height: var(--space-13);
    background-image: url('/images/journey/mesh-backdrop.jpg');
    background-size: cover;
    background-position: center;
    border-radius: var(--radius-none);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
    clip-path: inset(0 0 0 0);
  }

  .journey-badge-number {
    display: block;
    font-family: var(--font-display);
    font-optical-sizing: none;
    font-variation-settings: 'opsz' 72;
    font-weight: 600;
    font-size: var(--font-size-display);
    line-height: var(--leading-compressed);
    color: var(--color-canvas-white);
    user-select: none;
  }

  .journey-heading-lockup {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    gap: var(--space-03);
    min-width: 0;
  }

  .journey-lead-text {
    font-family: var(--font-display);
    font-optical-sizing: none;
    font-variation-settings: 'opsz' 72;
    font-weight: 400;
    font-size: var(--font-size-title);
    line-height: var(--leading-compressed);
    color: var(--color-canvas-white);
    text-transform: uppercase;
    letter-spacing: normal;
  }

  .journey-mission-text {
    font-family: var(--font-body);
    font-size: var(--font-size-body);
    line-height: var(--leading-body);
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 31ch;
    text-wrap: pretty;
  }

  /* Steps ledger: a connected stepper. Each rule is a leg of the route with a waypoint node. */
  .journey-list {
    list-style: none;
    margin: 0;
    padding: 0;
    min-width: 0;
  }

  .journey-step {
    position: relative;
    display: grid;
    grid-template-columns: var(--space-10) minmax(0, 1fr) minmax(0, 1fr);
    align-items: end;
    gap: var(--space-06);
    padding-block: var(--space-07);
    border-top: 1px solid var(--color-border-hairline);
    view-timeline: --journey-step block;
  }

  .journey-step:last-child {
    border-bottom: 1px solid var(--color-border-hairline);
  }

  /* Route trace: a Route Orange line laid over the hairline, drawn left to right */
  .journey-step::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: -1px;
    height: 1px;
    background-color: var(--color-route-orange);
    transform-origin: left center;
  }

  /* Waypoint node where the trace begins */
  .journey-step::after {
    content: '';
    position: absolute;
    left: 0;
    top: calc(var(--space-03) / -2);
    width: var(--space-03);
    height: var(--space-03);
    background-color: var(--color-route-orange);
  }

  .journey-step-numeral {
    align-self: start;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--font-size-label);
    line-height: var(--leading-default);
    color: var(--color-route-orange);
  }

  .journey-step-title {
    font-family: var(--font-display);
    font-optical-sizing: none;
    font-variation-settings: 'opsz' 72;
    font-weight: 500;
    font-size: var(--font-fluid-headline);
    line-height: var(--leading-compressed);
    letter-spacing: normal;
    color: var(--color-canvas-white);
    margin: 0;
  }

  .journey-step-desc {
    justify-self: end;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--font-size-label);
    line-height: var(--leading-body);
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 30ch;
    text-wrap: pretty;
  }

  @media (max-width: 1100px) {
    .journey-container {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Numeral keeps its own column; title and description stack beside it */
  @media (max-width: 860px) {
    .journey-step {
      grid-template-columns: var(--space-10) minmax(0, 1fr);
      row-gap: var(--space-05);
      column-gap: var(--space-05);
      padding-block: var(--space-06);
    }

    .journey-step-title {
      font-size: var(--font-fluid-title);
    }

    .journey-step-desc {
      grid-column: 2;
      justify-self: start;
    }
  }

  /* Phones: scale the lockup down so the badge and wordmark fit inside the gutters */
  @media (max-width: 640px) {
    .journey-container {
      padding-inline: var(--space-05);
    }

    .journey-masthead {
      gap: var(--space-06);
    }

    .journey-lockup {
      gap: var(--space-05);
    }

    .journey-badge-square {
      width: var(--space-12);
      height: var(--space-12);
    }

    .journey-badge-number {
      font-size: var(--font-size-headline);
    }

    .journey-lead-text {
      font-size: var(--font-size-metric);
    }

    .journey-wordmark {
      font-size: var(--font-size-wordmark);
    }

    .journey-mission-text {
      font-size: var(--font-size-label);
    }

    .journey-step {
      grid-template-columns: var(--space-09) minmax(0, 1fr);
    }
  }

  /* Scroll-driven route drawing. CSS only; unsupported browsers keep the settled layout. */
  @keyframes journey-wipe {
    from {
      clip-path: inset(100% 0 0 0);
    }

    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes journey-rise {
    from {
      opacity: 0;
      transform: translateY(var(--space-06));
      filter: blur(var(--space-01));
    }

    to {
      opacity: 1;
      transform: none;
      filter: blur(0);
    }
  }

  @keyframes journey-trace {
    from {
      transform: scaleX(0);
    }

    to {
      transform: scaleX(1);
    }
  }

  @keyframes journey-node {
    from {
      transform: scale(0);
    }

    to {
      transform: scale(1);
    }
  }

  @keyframes journey-fade {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  @supports (animation-timeline: view()) {
    .journey-badge-square,
    .journey-badge-number,
    .journey-heading-lockup,
    .journey-mission-text,
    .journey-step::before,
    .journey-step::after,
    .journey-step-numeral,
    .journey-step-title,
    .journey-step-desc {
      animation-fill-mode: both;
      animation-duration: auto;
      animation-timing-function: var(--ease-out-expo);
    }

    .journey-badge-square,
    .journey-badge-number,
    .journey-heading-lockup,
    .journey-mission-text {
      animation-timeline: --journey-masthead;
    }

    .journey-step::before,
    .journey-step::after,
    .journey-step-numeral,
    .journey-step-title,
    .journey-step-desc {
      animation-timeline: --journey-step;
    }

    @media (prefers-reduced-motion: no-preference) {
      .journey-badge-square {
        animation-name: journey-wipe;
        animation-range: entry 20% cover 40%;
      }

      .journey-badge-number {
        animation-name: journey-rise;
        animation-range: entry 40% cover 45%;
      }

      .journey-heading-lockup {
        animation-name: journey-rise;
        animation-range: entry 30% cover 42%;
      }

      .journey-mission-text {
        animation-name: journey-rise;
        animation-range: cover 20% cover 50%;
      }

      /* The node lands first, then the trace runs out from it while the text follows */
      .journey-step::after {
        animation-name: journey-node;
        animation-range: entry 30% entry 90%;
      }

      .journey-step::before {
        animation-name: journey-trace;
        animation-range: entry 50% cover 45%;
      }

      .journey-step-numeral {
        animation-name: journey-rise;
        animation-range: entry 60% cover 35%;
      }

      .journey-step-title {
        animation-name: journey-rise;
        animation-range: entry 70% cover 42%;
      }

      .journey-step-desc {
        animation-name: journey-rise;
        animation-range: entry 90% cover 48%;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .journey-heading-lockup,
      .journey-mission-text,
      .journey-step-numeral,
      .journey-step-title,
      .journey-step-desc {
        animation-name: journey-fade;
        animation-range: entry 20% cover 40%;
      }
    }
  }
</style>
