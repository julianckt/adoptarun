---
/**
 * JourneySection.astro
 *
 * Section 03: 3-Step Caretaker Journey (Issue #6):
 * - Displays the 3 steps to adopting a run (Match & Commit, Grow & Nurture, Forever Guardian).
 * - Square backdrop (240px x 240px) with authentic noise gradient mesh for the giant digit "3".
 * - Downscaled 80px wordmark maintaining exact variable font axis ratios.
 * - Overlapping editorial cadence with alternating left/right lockups.
 * - Premium IntersectionObserver scroll entrance animations with cubic-bezier drift.
 *
 * All styles strictly comply with DESIGN.md and Lumos tokens.
 */
---

<section id="journey-section" class="journey-section" aria-label="3 Steps to Adopt a Run">
  <div class="journey-container">
    <!-- Journey Header -->
    <header class="journey-header">
      <!-- Frame 48: Square Mesh Backdrop with giant 3 -->
      <div class="journey-badge-square" aria-hidden="true">
        <span class="journey-badge-number">3</span>
      </div>

      <!-- Frame 47: STEPS TO + downscaled 80px wordmark -->
      <div class="journey-heading-lockup">
        <span class="journey-lead-text">STEPS TO</span>
        <div class="c-wordmark c-wordmark--headline" aria-label="adopt a run">
          <span class="c-wordmark-line"><span class="c-wordmark-adopt">adopt</span></span>
          <span class="c-wordmark-line"><span class="c-wordmark-a">a</span><span class="c-wordmark-space">&nbsp;</span><span class="c-wordmark-run">run</span></span>
        </div>
      </div>

      <!-- Frame 49: Right-aligned commitment copy -->
      <div class="journey-mission-lockup">
        <p class="journey-mission-text">
          make commitments to yourself and to your<br />community – run the route and own the impact
        </p>
      </div>
    </header>

    <!-- Journey List of 3 Steps -->
    <div class="journey-list">
      <!-- Step 1: Match & Commit -->
      <div class="journey-step journey-step-1" data-step="1" style="--step-index: 0;">
        <h3 class="journey-step-title">
          match+<br />commit
        </h3>
        <p class="journey-step-desc">
          <strong class="journey-step-numeral">one.</strong><br />
          match with an animal route, and choose a charity cause to pair with and commit to
        </p>
      </div>

      <!-- Step 2: Grow & Nurture (alternating right-aligned flow) -->
      <div class="journey-step journey-step-2" data-step="2" style="--step-index: 1;">
        <p class="journey-step-desc journey-step-desc--right">
          <strong class="journey-step-numeral">two.</strong><br />
          bring your animal to life with your running steps and fundraise to nurture your cause
        </p>
        <h3 class="journey-step-title">
          grow+<br />nurture
        </h3>
      </div>

      <!-- Step 3: Forever Guardian -->
      <div class="journey-step journey-step-3" data-step="3" style="--step-index: 2;">
        <h3 class="journey-step-title">
          forever<br />guardian
        </h3>
        <p class="journey-step-desc">
          <strong class="journey-step-numeral">three.</strong><br />
          own your success in running and in impact! Hand off your run to its next caretaker
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .journey-section {
    width: 100%;
    background-color: var(--color-canvas-black);
    position: relative;
    z-index: 10;
    display: flex;
    justify-content: center;
    padding-top: var(--space-10);
    padding-bottom: var(--space-10);
    box-sizing: border-box;
  }

  .journey-container {
    width: 100%;
    max-width: 1416px;
    padding-left: var(--space-03);
    padding-right: var(--space-03);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-06);
    box-sizing: border-box;
  }

  /* Journey Header */
  .journey-header {
    width: 100%;
    display: flex;
    flex-direction: row;
    align-items: flex-end;
    gap: var(--space-09);
    min-height: calc(var(--space-11) * 3); /* 240px matching square backdrop */
    box-sizing: border-box;
  }

  /* Frame 48: 240px Square Backdrop with Mesh */
  .journey-badge-square {
    width: calc(var(--space-11) * 3);
    height: calc(var(--space-11) * 3);
    background-image: url('/images/journey/mesh-backdrop.jpg');
    background-size: cover;
    background-position: center;
    border-radius: var(--radius-none);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .journey-badge-number {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--font-size-giant);
    line-height: var(--leading-default);
    color: var(--color-canvas-white);
    display: flex;
    align-items: center;
    justify-content: center;
    user-select: none;
    margin: 0;
    padding: 0;
  }

  /* Frame 47: STEPS TO + wordmark */
  .journey-heading-lockup {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    gap: var(--space-03);
    box-sizing: border-box;
  }

  .journey-lead-text {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--font-size-title);
    line-height: var(--leading-default);
    color: var(--color-canvas-white);
    text-transform: uppercase;
    letter-spacing: 0;
    margin: 0;
  }

  /* Frame 49: Mission / commitment right-aligned */
  .journey-mission-lockup {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-end;
    flex-grow: 1;
    margin-left: auto;
    box-sizing: border-box;
  }

  .journey-mission-text {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--font-size-body);
    line-height: var(--leading-body);
    text-align: right;
    color: var(--color-canvas-white);
    margin: 0;
  }

  /* Journey List of 3 Steps */
  .journey-list {
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    box-sizing: border-box;
  }

  /* Step Row Common */
  .journey-step {
    width: 100%;
    display: flex;
    flex-direction: row;
    align-items: flex-end;
    gap: var(--space-06);
    box-sizing: border-box;
    /* Animation initial state */
    opacity: 0;
    transform: translateY(var(--space-06));
    transition: opacity 800ms cubic-bezier(0.16, 1, 0.3, 1),
                transform 800ms cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(var(--step-index, 0) * 120ms);
    will-change: opacity, transform;
  }

  /* Overlapping editorial cadence with negative vertical spacing */
  .journey-step-1 {
    margin-bottom: calc(var(--space-09) * -1);
  }

  .journey-step-2 {
    justify-content: flex-end;
    margin-bottom: calc(var(--space-09) * -1);
  }

  .journey-step-3 {
    justify-content: flex-start;
  }

  /* Entrance Animation Triggered */
  .journey-step.is-visible {
    opacity: 1;
    transform: translateY(var(--space-00));
  }

  /* Step Headings */
  .journey-step-title {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--font-size-feature);
    line-height: var(--leading-compressed);
    color: var(--color-canvas-white);
    margin: 0;
    padding: 0;
    white-space: pre-line;
  }

  /* Step Descriptions */
  .journey-step-desc {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--font-size-metric);
    line-height: var(--leading-body);
    color: var(--color-canvas-white);
    max-width: 284px;
    margin: 0;
    padding: 0;
  }

  .journey-step-desc--right {
    text-align: right;
    max-width: 260px;
  }

  .journey-step-numeral {
    font-weight: 700;
  }

  /* Accessibility: Prefers Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .journey-step {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  function initJourneyScrollObserver() {
    const steps = document.querySelectorAll<HTMLElement>('.journey-step');
    if (!steps.length) return;

    if (!('IntersectionObserver' in window)) {
      steps.forEach((step) => step.classList.add('is-visible'));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.15,
        rootMargin: '0px 0px -40px 0px',
      }
    );

    steps.forEach((step) => {
      observer.observe(step);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initJourneyScrollObserver);
  } else {
    initJourneyScrollObserver();
  }
</script>
