---
/**
 * JourneySection.astro
 *
 * Section 03: 3-Step Caretaker Journey (Issue #6):
 * - Displays the 3 steps to adopting a run (Match & Commit, Grow & Nurture, Forever Guardian).
 * - Split layout: masthead (mesh-backdrop "3" + STEPS TO wordmark lockup + mission) on the left,
 *   the 3 steps as a hairline-ruled ledger on the right. Stacks to one column below 1100px.
 * - Connected stepper: each rule carries a square waypoint node and a Route Orange trace.
 *
 * Scroll storytelling (smoothed scroll scrub, same pattern as CharitySection): the mesh badge
 * wipes open, then each step's node lands, its trace draws along the rule and its text rises out
 * of a soft blur. The script writes a 0 → 1 --p per block; CSS derives every stage from it.
 * --p defaults to 1, so no-JS and reduced motion show the settled layout.
 *
 * All styles strictly comply with DESIGN.md and Lumos tokens.
 */
---

<section id="journey-section" class="journey-section" aria-labelledby="journey-heading">
  <div class="journey-container">
    <header class="journey-masthead">
      <h2 id="journey-heading" class="journey-lockup" aria-label="3 steps to adopt a run">
        <span class="journey-badge-square" aria-hidden="true">
          <span class="journey-badge-number">3</span>
        </span>
        <span class="journey-heading-lockup" aria-hidden="true">
          <span class="journey-lead-text">STEPS TO</span>
          <span class="c-wordmark c-wordmark--headline journey-wordmark">
            <span class="c-wordmark-line"><span class="c-wordmark-adopt">adopt</span></span>
            <span class="c-wordmark-line"><span class="c-wordmark-a">a</span><span class="c-wordmark-space">&nbsp;</span><span class="c-wordmark-run">run</span></span>
          </span>
        </span>
      </h2>
      <p class="journey-mission-text">make commitments to yourself and to your community – run the route and own the impact</p>
    </header>

    <ol class="journey-list">
      <li class="journey-step">
        <span class="journey-step-numeral">one.</span>
        <h3 class="journey-step-title">match+<br />commit</h3>
        <p class="journey-step-desc">match with an animal route, and choose a charity cause to pair with and commit to</p>
      </li>
      <li class="journey-step">
        <span class="journey-step-numeral">two.</span>
        <h3 class="journey-step-title">grow+<br />nurture</h3>
        <p class="journey-step-desc">bring your animal to life with your running steps and fundraise to nurture your cause</p>
      </li>
      <li class="journey-step">
        <span class="journey-step-numeral">three.</span>
        <h3 class="journey-step-title">forever<br />guardian</h3>
        <p class="journey-step-desc">own your success in running and in impact! Hand off your run to its next caretaker</p>
      </li>
    </ol>
  </div>
</section>

<style>
  .journey-section {
    width: 100%;
    background-color: var(--color-canvas-black);
    position: relative;
    z-index: 10;
  }

  /* Shares About's frame and gutters so the two sections read as one run of content */
  .journey-container {
    width: 100%;
    max-width: 1512px;
    margin: 0 auto;
    padding-block: var(--space-fluid-xl) var(--space-fluid-3xl);
    padding-inline: var(--space-fluid-xl);
    box-sizing: border-box;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-fluid-2xl);
    align-items: start;
    color: var(--color-canvas-white);
  }

  /* Masthead */
  .journey-masthead {
    display: flex;
    flex-direction: column;
    gap: var(--space-07);
    min-width: 0;
  }

  .journey-lockup {
    display: flex;
    align-items: flex-end;
    gap: var(--space-06);
    margin: 0;
    font-weight: inherit;
  }

  .journey-badge-square {
    width: var(--space-13);
    height: var(--space-13);
    background-image: url('/images/journey/mesh-backdrop.jpg');
    background-size: cover;
    background-position: center;
    border-radius: var(--radius-none);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
    clip-path: inset(0 0 0 0);
  }

  .journey-badge-number {
    display: block;
    font-family: var(--font-display);
    font-optical-sizing: none;
    font-variation-settings: 'opsz' 72;
    font-weight: 600;
    font-size: var(--font-size-display);
    line-height: var(--leading-compressed);
    color: var(--color-canvas-white);
    user-select: none;
  }

  .journey-heading-lockup {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    gap: var(--space-03);
    min-width: 0;
  }

  .journey-lead-text {
    font-family: var(--font-display);
    font-optical-sizing: none;
    font-variation-settings: 'opsz' 72;
    font-weight: 400;
    font-size: var(--font-size-title);
    line-height: var(--leading-compressed);
    color: var(--color-canvas-white);
    text-transform: uppercase;
    letter-spacing: normal;
  }

  .journey-mission-text {
    font-family: var(--font-body);
    font-size: var(--font-size-body);
    line-height: var(--leading-body);
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 31ch;
    text-wrap: pretty;
  }

  /* Steps ledger: a connected stepper. Each rule is a leg of the route with a waypoint node. */
  .journey-list {
    list-style: none;
    margin: 0;
    padding: 0;
    min-width: 0;
  }

  .journey-step {
    position: relative;
    display: grid;
    grid-template-columns: var(--space-10) minmax(0, 1fr) minmax(0, 1fr);
    align-items: end;
    gap: var(--space-06);
    padding-block: var(--space-07);
    border-top: 1px solid var(--color-border-hairline);
  }

  .journey-step:last-child {
    border-bottom: 1px solid var(--color-border-hairline);
  }

  /* Route trace: a Route Orange line laid over the hairline, drawn left to right */
  .journey-step::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: -1px;
    height: 1px;
    background-color: var(--color-route-orange);
    transform-origin: left center;
  }

  /* Waypoint node where the trace begins */
  .journey-step::after {
    content: '';
    position: absolute;
    left: 0;
    top: calc(var(--space-03) / -2);
    width: var(--space-03);
    height: var(--space-03);
    background-color: var(--color-route-orange);
  }

  .journey-step-numeral {
    align-self: start;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--font-size-label);
    line-height: var(--leading-default);
    color: var(--color-route-orange);
  }

  .journey-step-title {
    font-family: var(--font-display);
    font-optical-sizing: none;
    font-variation-settings: 'opsz' 72;
    font-weight: 500;
    font-size: var(--font-fluid-headline);
    line-height: var(--leading-compressed);
    letter-spacing: normal;
    color: var(--color-canvas-white);
    margin: 0;
  }

  .journey-step-desc {
    justify-self: end;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--font-size-label);
    line-height: var(--leading-body);
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 30ch;
    text-wrap: pretty;
  }

  @media (max-width: 1100px) {
    .journey-container {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Numeral keeps its own column; title and description stack beside it */
  @media (max-width: 860px) {
    .journey-step {
      grid-template-columns: var(--space-10) minmax(0, 1fr);
      row-gap: var(--space-05);
      column-gap: var(--space-05);
      padding-block: var(--space-06);
    }

    .journey-step-title {
      font-size: var(--font-fluid-title);
    }

    .journey-step-desc {
      grid-column: 2;
      justify-self: start;
    }
  }

  /* Phones: scale the lockup down so the badge and wordmark fit inside the gutters */
  @media (max-width: 640px) {
    .journey-container {
      padding-inline: var(--space-05);
    }

    .journey-masthead {
      gap: var(--space-06);
    }

    .journey-lockup {
      gap: var(--space-05);
    }

    .journey-badge-square {
      width: var(--space-12);
      height: var(--space-12);
    }

    .journey-badge-number {
      font-size: var(--font-size-headline);
    }

    .journey-lead-text {
      font-size: var(--font-size-metric);
    }

    .journey-wordmark {
      font-size: var(--font-size-wordmark);
    }

    .journey-mission-text {
      font-size: var(--font-size-label);
    }

    .journey-step {
      grid-template-columns: var(--space-09) minmax(0, 1fr);
    }
  }

  /* Scroll storytelling: the script scrubs --p (0 → 1) on the masthead and each step.
     Every stage maps its own window of --p to a local 0 → 1 progress (--t). */
  .journey-masthead,
  .journey-step {
    --p: 1;
  }

  .journey-badge-square {
    --t: clamp(0, calc(var(--p) / 0.55), 1);
    clip-path: inset(calc((1 - var(--t)) * 100%) 0 0 0);
  }

  .journey-badge-number {
    --t: clamp(0, calc((var(--p) - 0.15) / 0.55), 1);
  }

  .journey-heading-lockup {
    --t: clamp(0, calc((var(--p) - 0.1) / 0.55), 1);
  }

  .journey-mission-text {
    --t: clamp(0, calc((var(--p) - 0.3) / 0.6), 1);
  }

  .journey-step-numeral {
    --t: clamp(0, calc((var(--p) - 0.15) / 0.5), 1);
  }

  .journey-step-title {
    --t: clamp(0, calc((var(--p) - 0.22) / 0.55), 1);
  }

  .journey-step-desc {
    --t: clamp(0, calc((var(--p) - 0.32) / 0.6), 1);
  }

  .journey-badge-number,
  .journey-heading-lockup,
  .journey-mission-text,
  .journey-step-numeral,
  .journey-step-title,
  .journey-step-desc {
    opacity: var(--t);
    transform: translateY(calc((1 - var(--t)) * var(--space-06)));
    filter: blur(calc((1 - var(--t)) * var(--space-01)));
  }

  /* Node lands first, then the trace runs out from it */
  .journey-step::after {
    transform: scale(clamp(0, calc(var(--p) / 0.2), 1));
  }

  .journey-step::before {
    transform: scaleX(clamp(0, calc((var(--p) - 0.1) / 0.65), 1));
  }
</style>

<script>
  function initJourneyScrub() {
    const section = document.getElementById('journey-section');
    if (!section) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const blocks = Array.from(
      section.querySelectorAll<HTMLElement>('.journey-masthead, .journey-step')
    );

    // A block's progress runs 0 → 1 as its top travels from the viewport bottom to 45% up it
    const SPAN = 0.55;
    const RATE = 0.09;

    const clamp01 = (v: number) => Math.min(1, Math.max(0, v));
    const easeOutCubic = (t: number) => 1 - Math.pow(1 - t, 3);
    const approach = (current: number, target: number, dt: number) =>
      current + (target - current) * (1 - Math.pow(1 - RATE, dt / (1000 / 60)));

    const readTargets = () => {
      const vh = window.innerHeight;
      return blocks.map((el) =>
        easeOutCubic(clamp01((vh - el.getBoundingClientRect().top) / (vh * SPAN)))
      );
    };

    let state = readTargets();
    const write = () =>
      blocks.forEach((el, i) => el.style.setProperty('--p', state[i].toFixed(4)));
    write();

    let running = false;
    let lastTime = 0;

    function step(now: number) {
      const dt = lastTime ? Math.min(64, now - lastTime) : 1000 / 60;
      lastTime = now;

      const targets = readTargets();
      state = state.map((v, i) => approach(v, targets[i], dt));
      write();

      if (state.every((v, i) => Math.abs(v - targets[i]) < 0.001)) {
        running = false;
        lastTime = 0;
      } else {
        requestAnimationFrame(step);
      }
    }

    function kick() {
      if (running) return;
      running = true;
      requestAnimationFrame(step);
    }

    window.addEventListener('scroll', kick, { passive: true });
    window.addEventListener('resize', kick, { passive: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initJourneyScrub);
  } else {
    initJourneyScrub();
  }
</script>
