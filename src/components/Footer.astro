---
export interface Props {
  class?: string;
  /** 'full' renders contact, nav and legal rows; 'minimal' renders only the legal row. */
  variant?: 'full' | 'minimal';
  [key: string]: any;
}

const { class: className, variant = 'full', ...restProps } = Astro.props;
const isMinimal = variant === 'minimal';
---

<footer class:list={['site-footer', { 'site-footer--minimal': isMinimal }, className]} {...restProps}>
  {!isMinimal && (<>
  <p class="site-footer-contact">
    <span>Contact us at</span>
    <a class="site-footer-email" href="mailto:adoptarunhk@gmail.com">adoptarunhk@gmail.com<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 12L12 4M5 4h7v7" /></svg></a>
  </p>
  <div class="site-footer-body">
    <nav aria-label="Footer">
      <ul class="site-footer-list site-footer-list--site">
        <li><a href="/routes">routes<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 12L12 4M5 4h7v7" /></svg></a></li>
        <li><a href="/charities">charities<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 12L12 4M5 4h7v7" /></svg></a></li>
        <li><a href="/signup">adopt a route<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 12L12 4M5 4h7v7" /></svg></a></li>
        <li><a href="/donate">donate<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 12L12 4M5 4h7v7" /></svg></a></li>
        <li><a href="/log">log a run<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 12L12 4M5 4h7v7" /></svg></a></li>
        <li><a href="#">back to top<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M8 13V3M4 7l4-4 4 4" /></svg></a></li>
      </ul>
    </nav>
    <nav aria-label="Community">
      <ul class="site-footer-list">
        <li><a href="https://strava.com/clubs/adoptarun" target="_blank" rel="noopener noreferrer">strava club<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 12L12 4M5 4h7v7" /></svg></a></li>
        <li><a href="https://instagram.com/adoptarun" target="_blank" rel="noopener noreferrer">instagram<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 12L12 4M5 4h7v7" /></svg></a></li>
        <li><a href="https://github.com/julianckt/adoptarun" target="_blank" rel="noopener noreferrer">github<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 12L12 4M5 4h7v7" /></svg></a></li>
      </ul>
    </nav>
  </div>
  </>)}
  <div class="site-footer-base">
    <p>© {new Date().getFullYear()} adopt a run. all rights reserved.</p>
    <nav aria-label="Legal">
      <a href="/privacy">privacy policy</a>
      <a href="/terms">terms &amp; conditions</a>
    </nav>
    <p>designed by jckt</p>
  </div>
</footer>
