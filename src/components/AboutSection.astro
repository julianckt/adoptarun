---
/**
 * AboutSection.astro
 *
 * Homepage About section, merged with the live community movement counters:
 * - One display sentence with photographs set inline beside each movement pillar
 * - Mission paragraph (left) paired with a right-aligned tally sentence (right)
 * - Tally figures carry a route-colour underscore; values are props for future Sanity integration
 *
 * Scroll storytelling (progressive enhancement, fully visible without JS):
 * - Triggers 1–3 wipe open the Community, Exercise and Art photographs inside the sentence
 * - Trigger 4 lifts in the paragraph and the tally
 *
 * All styles strictly comply with DESIGN.md and Lumos tokens.
 */
interface Props {
  totalKmCovered?: number | string;
  totalRunsCompleted?: number | string;
  totalParticipantsCount?: number | string;
  totalAmountRaised?: number | string;
}

const {
  totalKmCovered = '00',
  totalRunsCompleted = '00',
  totalParticipantsCount = '00',
  totalAmountRaised = '00',
} = Astro.props;
---

<section id="about-section" class="about-container" aria-label="About adopt a run">
  <div class="about-content">
    <h2 class="about-sentence">
      <span class="about-lead">Your next run collective —</span>
      merging
      <span class="about-pic pic-community" aria-hidden="true">
        <img
          src="/images/about/community-puppy.jpg"
          alt=""
          loading="lazy"
          decoding="async"
        />
      </span>
      <b class="accent-community">Community</b>
      with
      <span class="about-pic pic-exercise" aria-hidden="true">
        <img
          src="/images/about/exercise-runners.jpg"
          alt=""
          loading="lazy"
          decoding="async"
        />
      </span>
      <b class="accent-exercise">Exercise</b>
      and
      <span class="about-pic pic-art" aria-hidden="true">
        <img
          src="/images/about/art-artlane.jpg"
          alt=""
          loading="lazy"
          decoding="async"
        />
      </span>
      <b class="accent-art">Art.</b>
    </h2>

    <div class="about-row">
      <p class="about-description">
        We are a budding community project, trying to bring together runners across Hong Kong. Seeking to infuse fun and flair into running all the whilst doing good for the community around us. Get involved in our growing movement and turn your compassion into action!
      </p>

      <p class="about-tally" aria-label="Live community movement counters">together we’ve run <span class="tally-mark mark-distance"><span class="tally-value">{totalKmCovered}</span>&#160;km</span> across <span class="tally-mark mark-runs"><span class="tally-value">{totalRunsCompleted}</span>&#160;runs</span> — <span class="tally-mark mark-runners"><span class="tally-value">{totalParticipantsCount}</span>&#160;runners</span> raising <span class="tally-mark mark-raised">HK$<span class="tally-value">{totalAmountRaised}</span></span> <span class="tally-end">and counting.</span></p>
    </div>
  </div>
</section>

<style>
  .about-container {
    width: 100%;
    background-color: var(--color-canvas-black);
    position: relative;
    z-index: 10;
  }

  .about-content {
    max-width: 1512px;
    margin: 0 auto;
    padding: var(--space-fluid-3xl) var(--space-fluid-xl);
    box-sizing: border-box;
    color: var(--color-canvas-white);
  }

  /* One sentence, photographs set into the line */
  .about-sentence {
    margin: var(--space-00);
    font-family: var(--font-display);
    font-optical-sizing: none;
    font-variation-settings: 'opsz' 72;
    font-size: var(--font-fluid-headline);
    font-weight: 400;
    line-height: 0.9;
    text-wrap: balance;
  }

  .about-lead,
  .about-sentence b {
    font-weight: 600;
  }

  .accent-community {
    color: var(--color-route-orange);
  }

  .accent-exercise {
    color: var(--color-exercise-pink);
  }

  .accent-art {
    color: var(--color-art-cyan);
  }

  .about-pic {
    display: inline-block;
    width: 2.5em;
    height: 0.66em;
    margin-inline: 0.08em;
    vertical-align: -0.02em;
    overflow: hidden;
    clip-path: inset(0 0 0 0);
    transition: clip-path 900ms var(--ease-out-expo),
                opacity 600ms var(--ease-out-expo);
  }

  .about-pic img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pic-community img {
    object-position: center 35%;
  }

  .pic-exercise img {
    object-position: center 45%;
  }

  /* Paragraph left, tally sentence right — tucked under the sentence */
  .about-row {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: var(--space-fluid-2xl);
    align-items: end;
    padding-top: var(--space-fluid-2xl);
  }

  .about-description {
    margin: var(--space-00);
    max-width: 31ch;
    font-family: var(--font-body);
    font-size: var(--font-size-body);
    line-height: var(--leading-body);
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  .about-tally {
    justify-self: start;
    margin: var(--space-00);
    max-width: 40ch;
    font-family: var(--font-display);
    font-optical-sizing: none;
    font-variation-settings: 'opsz' 72;
    font-size: var(--font-fluid-title);
    font-weight: 400;
    line-height: var(--leading-body);
    text-align: right;
    color: var(--color-text-secondary);
    text-wrap: balance;
  }

  .tally-mark {
    --mark-hue: var(--color-route-orange);
    padding-inline: 0.04em;
    font-weight: 600;
    color: var(--color-canvas-white);
    white-space: nowrap;
    text-decoration-line: underline;
    text-decoration-color: var(--mark-hue);
    text-decoration-thickness: 0.1em;
    text-underline-offset: 0.06em;
    text-decoration-skip-ink: none;
  }

  .mark-runs {
    --mark-hue: var(--color-route-coral);
  }

  .mark-runners {
    --mark-hue: var(--color-art-cyan);
  }

  .mark-raised {
    --mark-hue: var(--color-group-run-green);
  }

  .tally-value {
    font-variant-numeric: tabular-nums lining-nums;
  }

  .tally-end {
    color: var(--color-canvas-white);
  }

  .about-description,
  .about-tally {
    transition: opacity 600ms var(--ease-out-expo),
                transform 600ms var(--ease-out-expo);
  }

  /* Scroll storytelling: only armed once the script runs, so no-JS shows everything */
  :global(.about-container.is-armed:not(.is-triggered-1)) .pic-community,
  :global(.about-container.is-armed:not(.is-triggered-2)) .pic-exercise,
  :global(.about-container.is-armed:not(.is-triggered-3)) .pic-art {
    clip-path: inset(0 100% 0 0);
    opacity: 0;
  }

  :global(.about-container.is-armed:not(.is-triggered-4)) .about-description,
  :global(.about-container.is-armed:not(.is-triggered-4)) .about-tally {
    opacity: 0;
    transform: translateY(var(--space-06));
  }

  :global(.about-container.is-triggered-4) .about-tally {
    transition-delay: 150ms;
  }

  @media (max-width: 1024px) {
    .about-row {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-fluid-xl);
    }

    .about-tally {
      justify-self: start;
      text-align: left;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-pic,
    .about-description,
    .about-tally {
      transition: none;
    }
  }
</style>

<script>
  function initAboutScrollTriggers() {
    const section = document.getElementById('about-section');
    if (!section) return;

    // Thresholds are fractions of viewport height the section top must pass
    const stages = [0.4, 0.25, 0.1, 0];
    const fired = stages.map(() => false);

    const onScroll = () => {
      const top = section.getBoundingClientRect().top;
      const vh = window.innerHeight;

      stages.forEach((threshold, i) => {
        if (!fired[i] && top <= vh * threshold) {
          fired[i] = true;
          section.classList.add(`is-triggered-${i + 1}`);
        }
      });

      if (fired.every(Boolean)) window.removeEventListener('scroll', onScroll);
    };

    section.classList.add('is-armed');
    window.addEventListener('scroll', onScroll, { passive: true });
    // Check immediately in case page loaded partway down
    onScroll();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAboutScrollTriggers);
  } else {
    initAboutScrollTriggers();
  }
</script>
