---
import type { SanityRoute } from '@/sanity/types';
import {
  formatRouteDistance,
  formatRouteDuration,
  formatRouteElevation,
  formatRouteDifficulty,
  formatRouteTags,
} from '@/utils/formatters';

export interface Props {
  class?: string;
  route: SanityRoute;
  colorTheme?: 'route-orange' | 'route-coral' | 'route-blush';
  /**
   * What clicking the card does.
   * 'none'   — a plain article, the default; nothing is interactive.
   * 'link'   — wraps in an anchor (homepage and featured grid go to /routes).
   * 'expand' — wraps in a button that opens the expanded card in a dialog.
   * 'select' — picks this Artwork inside the Adoption Portal, announcing the
   *            choice as a `route-card:select` event rather than navigating.
   */
  action?: 'none' | 'link' | 'expand' | 'select';
  /** For action="select": whether this Artwork is the one currently chosen. */
  selected?: boolean;
  /** Destination for action="link". */
  href?: string;
  /** Which map the expanded card should show; 'minimap' avoids a map on a map. */
  mapMode?: 'leaflet' | 'minimap';
  [key: string]: any;
}

const {
  class: className,
  route,
  colorTheme = 'route-orange',
  action = 'none',
  selected = false,
  href = '/routes',
  mapMode = 'leaflet',
  ...restProps
} = Astro.props;

const {
  district,
  tags,
  distanceKm,
  estimatedDurationMin,
  elevationGain,
  difficulty = 'beginner',
  isGroupRun = false,
  groupRunDateTime,
  groupRunSignupCount,
} = route;

const miniMapSvg = route.miniMapSvg || (route as any).gpxFile?.miniMapSvg;

const themeClass =
  colorTheme === 'route-coral'
    ? 'route-card--coral'
    : colorTheme === 'route-blush'
      ? 'route-card--blush'
      : 'route-card--orange';

const formattedDistance = formatRouteDistance(distanceKm);
const formattedDuration = formatRouteDuration(estimatedDurationMin);
const formattedElevation = formatRouteElevation(elevationGain);
const formattedDifficulty = formatRouteDifficulty(difficulty);
const displayTags = formatRouteTags(tags);

// Group run bookmark: rendered only when the route carries a valid start time
const groupRunAt = groupRunDateTime ? new Date(groupRunDateTime) : null;
const hk = { timeZone: 'Asia/Hong_Kong' } as const;
const groupRunStart =
  groupRunAt && !Number.isNaN(groupRunAt.getTime())
    ? (() => {
        const [clock, period] = groupRunAt
          .toLocaleTimeString('en-US', { ...hk, hour: 'numeric', minute: '2-digit', hour12: true })
          .split(/\s/);
        return {
          iso: groupRunAt.toISOString(),
          weekday: groupRunAt.toLocaleDateString('en-GB', { ...hk, weekday: 'short' }),
          day: groupRunAt.toLocaleDateString('en-GB', { ...hk, day: '2-digit' }),
          month: groupRunAt.toLocaleDateString('en-GB', { ...hk, month: 'short' }),
          clock,
          period,
        };
      })()
    : null;
const showSignups = isGroupRun && typeof groupRunSignupCount === 'number';

// The card's behaviour is decided at build time by its call site. The trigger
// is a stretched overlay INSIDE the article rather than a wrapper around it:
// a <button> may only contain phrasing content, so wrapping the article (with
// its heading and <time>) would be invalid markup and would erase both from
// assistive navigation.
const routeSlug = route.slug?.current ?? '';
---

<article
  class:list={[
    'route-card',
    themeClass,
    { 'route-card--group-run': isGroupRun, 'route-card--selected': action === 'select' && selected },
    className,
  ]}
  {...restProps}
>
  <!-- Night Plate: full-bleed map under a veil, framed by the route color -->
  <div class="route-card-plate">
    <div class="route-card-minimap">
      <slot name="minimap">
        {miniMapSvg ? (
          <div class="route-card-minimap-svg" set:html={miniMapSvg} />
        ) : (
          <div class="route-card-minimap-placeholder" aria-label="Route minimap placeholder">
            <span class="route-card-placeholder-label">gps trace</span>
          </div>
        )}
      </slot>
    </div>

    {isGroupRun ? (
      <div class="route-card-top">
        <!-- Group Run Bookmark: date & start time -->
        {groupRunStart && (
          <time class="route-card-bookmark" datetime={groupRunStart.iso}>
            <span class="route-card-bookmark-flag">group run</span>
            <span class="route-card-bookmark-weekday">{groupRunStart.weekday}</span>
            <span class="route-card-bookmark-day">{groupRunStart.day}</span>
            <span class="route-card-bookmark-month">{groupRunStart.month}</span>
            <span class="route-card-bookmark-time">
              {groupRunStart.clock}<span class="route-card-bookmark-period">{groupRunStart.period}</span>
            </span>
          </time>
        )}
        <div class="route-card-head">
          <div class="route-card-heading-group">
            <h3 class="route-card-district">{district}</h3>
            {displayTags && <p class="route-card-tags">{displayTags}</p>}
          </div>
          {(formattedDuration || formattedElevation) && (
          <dl class="route-card-telemetry">
            {formattedDuration && (
              <div class="route-card-metric"><dt>est.</dt><dd>{formattedDuration}</dd></div>
            )}
            {formattedElevation && (
              <div class="route-card-metric"><dt>elev.</dt><dd>{formattedElevation}</dd></div>
            )}
          </dl>
        )}
        </div>
      </div>
    ) : (
      <div class="route-card-top">
        <div class="route-card-heading-group">
          <h3 class="route-card-district">{district}</h3>
          {displayTags && <p class="route-card-tags">{displayTags}</p>}
        </div>
        {(formattedDuration || formattedElevation) && (
          <dl class="route-card-telemetry">
            {formattedDuration && (
              <div class="route-card-metric"><dt>est.</dt><dd>{formattedDuration}</dd></div>
            )}
            {formattedElevation && (
              <div class="route-card-metric"><dt>elev.</dt><dd>{formattedElevation}</dd></div>
            )}
          </dl>
        )}
      </div>
    )}

    {showSignups && <p class="route-card-signups">{groupRunSignupCount} signed up</p>}

    <!-- Color Band: Difficulty & Distance -->
    <div class="route-card-band">
      <span class="route-card-difficulty">{formattedDifficulty}</span>
      <span class="route-card-distance">{formattedDistance}</span>
    </div>
  </div>

  {action === 'link' && (
    <a class="route-card-trigger" href={href}>view {district} route</a>
  )}
  {action === 'expand' && (
    <button
      type="button"
      class="route-card-trigger"
      aria-haspopup="dialog"
      data-route-expand
      data-route-slug={routeSlug}
      data-map-mode={mapMode}
    >expand {district} route details</button>
  )}
  {action === 'select' && (
    <button
      type="button"
      class="route-card-trigger"
      aria-pressed={selected ? 'true' : 'false'}
      data-route-select
      data-route-slug={routeSlug}
    >adopt the {district} route</button>
  )}

  <slot />
</article>
