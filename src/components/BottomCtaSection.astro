---
/**
 * BottomCtaSection.astro
 *
 * Section 06: Action Banner CTA (Issue #6):
 * - Full-stage finale staged over living WebGL shader background (Shader Preset A).
 * - Outside the curtain with transparent background; a seam scrim dissolves out of the
 *   charity curtain above and into the footer below so the shader breathes through the middle.
 * - Element id="bottom-cta" triggers ShaderBackground.tsx IntersectionObserver for Preset A.
 * - 3-line stacked rhythmic cadence in Degular Display ("adopt the run. / complete the route. / own the impact.").
 * - Primary CTA: "run with us →" (with "run" in Scale VF) linking to /signup.
 * - Secondary CTA: "pass the torch →" with Smart Web Share & zero-library clipboard fallback.
 *
 * All styles strictly comply with DESIGN.md, Lumos tokens, and zero-radius architecture.
 */
export interface Props {
  class?: string;
  [key: string]: any;
}

const { class: className, ...restProps } = Astro.props;
---

<section id="bottom-cta" class:list={['finale', className]} aria-labelledby="finale-heading" {...restProps}>
  <!-- Seam Scrim (Complies with Scrim Protection Rule in DESIGN.md) -->
  <div class="finale-scrim" aria-hidden="true"></div>

  <div class="finale-inner">
    <h2 id="finale-heading" class="finale-headline">
      <span class="finale-line">adopt the run.</span>
      <span class="finale-line">complete the route.</span>
      <span class="finale-line">own the impact.</span>
    </h2>

    <p class="finale-subtext">
      every kilometer drawn on the city's pavement raises rescue funds and champions a kinder city.
    </p>

    <div class="finale-actions">
      <a href="/signup" class="btn btn-primary finale-cta">
        <span class="brand-run">run</span> with us <span class="finale-cta-arrow" aria-hidden="true">&rarr;</span>
      </a>

      <button type="button" id="pass-torch-btn" class="hairline-link hairline-link--white finale-torch" aria-live="polite">
        pass the torch &rarr;
      </button>
    </div>
  </div>
</section>

<script>
  function setupPassTorch() {
    const passTorchBtn = document.getElementById('pass-torch-btn');
    if (!passTorchBtn) return;

    let resetTimer: ReturnType<typeof setTimeout> | null = null;

    passTorchBtn.addEventListener('click', async () => {
      const shareData = {
        title: 'adopt a run — gps art community movement',
        text: 'join me in adopting a gps art run with adopt a run — the new way to push yourself in training and in giving back.',
        url: window.location.origin || 'https://adoptarun.org',
      };

      // 1. Try Native Web Share API (mobile devices / supported browsers)
      if (typeof navigator !== 'undefined' && navigator.share && navigator.canShare && navigator.canShare(shareData)) {
        try {
          await navigator.share(shareData);
          return;
        } catch (err: unknown) {
          // User cancelled / dismissed the native share sheet
          if (err instanceof Error && err.name === 'AbortError') {
            return;
          }
        }
      }

      // 2. Clipboard Fallback with Inline Micro-Feedback
      try {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          await navigator.clipboard.writeText(shareData.url);
          if (resetTimer) clearTimeout(resetTimer);
          passTorchBtn.textContent = 'link copied to clipboard ✓';
          resetTimer = setTimeout(() => {
            passTorchBtn.innerHTML = 'pass the torch &rarr;';
          }, 2500);
          return;
        }
      } catch {
        // Fallback for restricted clipboard permissions
      }

      // 3. Fallback prompt
      window.prompt('Copy invite link to pass the torch:', shareData.url);
    });
  }

  // Initialize on initial page load and on Astro view transitions
  setupPassTorch();
  document.addEventListener('astro:page-load', setupPassTorch);
</script>

<style>
  .finale {
    position: relative;
    z-index: 1;
    isolation: isolate;
    width: 100%;
    min-height: 100svh;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-block: var(--space-13);
    padding-inline: max(var(--space-09), var(--safe-inset-left)) max(var(--space-09), var(--safe-inset-right));
    background-color: transparent;
    overflow: hidden;
  }

  /* Seam scrim: long eased fades from solid Canvas Black at both edges, near-clear middle */
  .finale-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      var(--color-canvas-black) 0%,
      color-mix(in srgb, var(--color-canvas-black) 64%, transparent) 7%,
      color-mix(in srgb, var(--color-canvas-black) 31%, transparent) 17.6%,
      color-mix(in srgb, var(--color-canvas-black) 4%, transparent) 32%,
      color-mix(in srgb, var(--color-canvas-black) 4%, transparent) 68%,
      color-mix(in srgb, var(--color-canvas-black) 31%, transparent) 82.4%,
      color-mix(in srgb, var(--color-canvas-black) 64%, transparent) 93%,
      var(--color-canvas-black) 100%
    );
  }

  .finale-inner {
    container-type: inline-size;
    inline-size: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .finale-headline {
    margin: 0;
    font-family: var(--font-display);
    font-optical-sizing: none;
    font-variation-settings: 'opsz' 72;
    /* Fit the longest line ("complete the route.") to the container on narrow screens */
    font-size: min(var(--font-fluid-display), 12cqi);
    font-weight: 600;
    line-height: var(--leading-compressed);
    letter-spacing: normal;
    color: var(--color-canvas-white);
    text-wrap: balance;
  }

  .finale-line {
    display: block;
  }

  .finale-subtext {
    max-width: 40ch;
    margin: var(--space-08) 0 0;
    font-family: var(--font-body);
    font-size: var(--font-fluid-body);
    font-weight: 400;
    line-height: var(--leading-body);
    letter-spacing: normal;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  .finale-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-06);
    margin-top: var(--space-09);
  }

  /* Primary CTA: Specific finale overrides on top of .btn.btn-primary */
  .finale-cta {
    align-items: baseline;
    gap: var(--space-03);
    font-size: var(--font-size-body);
  }

  .finale-cta-arrow {
    display: inline-block;
    transition: transform 0.4s var(--ease-out-expo);
  }

  .finale-cta:hover {
    box-shadow: 0 var(--space-03) var(--space-08) color-mix(in srgb, var(--color-route-orange) 32%, transparent);
  }

  .finale-cta:hover .finale-cta-arrow {
    transform: translateX(var(--space-02));
  }

  .finale-cta:focus-visible,
  .finale-torch:focus-visible {
    outline: 1px solid var(--color-canvas-white);
    outline-offset: var(--space-02);
  }

  @media (max-width: 768px) {
    .finale {
      padding-block-start: var(--space-11);
      padding-block-end: max(var(--space-11), var(--safe-inset-bottom));
      padding-inline: max(var(--space-05), var(--safe-inset-left)) max(var(--space-05), var(--safe-inset-right));
    }

    .finale-subtext {
      margin-top: var(--space-06);
    }

    .finale-actions {
      flex-direction: column;
      align-items: center;
      width: 100%;
      gap: var(--space-03);
      margin-top: var(--space-08);
    }

    .finale-cta,
    .finale-torch {
      justify-content: center;
      min-block-size: var(--space-09);
    }

    .finale-cta {
      min-inline-size: 50%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .finale-cta,
    .finale-cta-arrow,
    .finale-torch {
      transition: none;
    }

    .finale-cta:hover .finale-cta-arrow {
      transform: none;
    }
  }

  /* Scroll-driven entrance: lines, subtext, and actions lift and resolve out of
     blur as they travel up the viewport. CSS only; content stays fully visible
     where view timelines are unsupported. */
  @keyframes finale-rise {
    from {
      opacity: 0;
      transform: translateY(var(--space-09));
      filter: blur(var(--space-03));
    }

    to {
      opacity: 1;
      transform: none;
      filter: blur(0);
    }
  }

  @keyframes finale-fade {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  @supports (animation-timeline: view()) {
    /* clip (not hidden) so the section is not a scroll container and each
       element's view() timeline tracks the page scroll */
    .finale {
      overflow: clip;
    }

    .finale-line,
    .finale-subtext,
    .finale-actions {
      animation-timeline: view();
      animation-fill-mode: both;
      animation-duration: auto;
      animation-timing-function: var(--ease-out-expo);
    }

    /* cover N% ≈ the element sitting N% up the viewport */
    @media (prefers-reduced-motion: no-preference) {
      .finale-line,
      .finale-subtext,
      .finale-actions {
        animation-name: finale-rise;
      }

      .finale-line:nth-child(1) {
        animation-range: cover 13% cover 43%;
      }

      .finale-line:nth-child(2) {
        animation-range: cover 15% cover 45%;
      }

      .finale-line:nth-child(3) {
        animation-range: cover 17% cover 47%;
      }

      .finale-subtext,
      .finale-actions {
        animation-range: cover 15% cover 30%;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .finale-line,
      .finale-subtext,
      .finale-actions {
        animation-name: finale-fade;
        animation-range: cover 15% cover 45%;
      }
    }
  }
</style>
