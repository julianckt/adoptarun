---
/**
 * BottomCtaSection.astro
 *
 * Section 06: Action Banner CTA (Issue #6):
 * - Full-stage finale staged over living WebGL shader background (Shader Preset A).
 * - Outside the curtain with transparent background; a seam scrim dissolves out of the
 *   charity curtain above and into the footer below so the shader breathes through the middle.
 * - Element id="bottom-cta" triggers ShaderBackground.tsx IntersectionObserver for Preset A.
 * - 3-line stacked rhythmic cadence in Degular Display ("adopt the run. / complete the route. / own the impact.").
 * - Primary CTA: "run with us →" (with "run" in Scale VF) linking to /signup.
 * - Secondary CTA: "pass the torch →" with Smart Web Share & zero-library clipboard fallback.
 *
 * All styles strictly comply with DESIGN.md, Lumos tokens, and zero-radius architecture.
 */
export interface Props {
  class?: string;
  [key: string]: any;
}

const { class: className, ...restProps } = Astro.props;
---

<section id="bottom-cta" class:list={['finale', className]} aria-labelledby="finale-heading" {...restProps}>
  <!-- Seam Scrim (Complies with Scrim Protection Rule in DESIGN.md) -->
  <div class="finale-scrim" aria-hidden="true"></div>

  <div class="finale-inner">
    <h2 id="finale-heading" class="finale-headline">
      <span class="finale-line">adopt the run.</span>
      <span class="finale-line">complete the route.</span>
      <span class="finale-line">own the impact.</span>
    </h2>

    <p class="finale-subtext">
      every kilometer drawn on the city's pavement raises rescue funds and champions a kinder city.
    </p>

    <div class="finale-actions">
      <a href="/signup" class="finale-cta">
        <span class="finale-cta-run">run</span> with us <span class="finale-cta-arrow" aria-hidden="true">&rarr;</span>
      </a>

      <button type="button" id="pass-torch-btn" class="finale-torch" aria-live="polite">
        pass the torch &rarr;
      </button>
    </div>
  </div>
</section>

<script>
  function setupPassTorch() {
    const passTorchBtn = document.getElementById('pass-torch-btn');
    if (!passTorchBtn) return;

    let resetTimer: ReturnType<typeof setTimeout> | null = null;

    passTorchBtn.addEventListener('click', async () => {
      const shareData = {
        title: 'adopt a run — gps art community movement',
        text: 'join me in adopting a gps art run with adopt a run — the new way to push yourself in training and in giving back.',
        url: window.location.origin || 'https://adoptarun.org',
      };

      // 1. Try Native Web Share API (mobile devices / supported browsers)
      if (typeof navigator !== 'undefined' && navigator.share && navigator.canShare && navigator.canShare(shareData)) {
        try {
          await navigator.share(shareData);
          return;
        } catch (err: unknown) {
          // User cancelled / dismissed the native share sheet
          if (err instanceof Error && err.name === 'AbortError') {
            return;
          }
        }
      }

      // 2. Clipboard Fallback with Inline Micro-Feedback
      try {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          await navigator.clipboard.writeText(shareData.url);
          if (resetTimer) clearTimeout(resetTimer);
          passTorchBtn.textContent = 'link copied to clipboard ✓';
          resetTimer = setTimeout(() => {
            passTorchBtn.innerHTML = 'pass the torch &rarr;';
          }, 2500);
          return;
        }
      } catch {
        // Fallback for restricted clipboard permissions
      }

      // 3. Fallback prompt
      window.prompt('Copy invite link to pass the torch:', shareData.url);
    });
  }

  // Initialize on initial page load and on Astro view transitions
  setupPassTorch();
  document.addEventListener('astro:page-load', setupPassTorch);
</script>

<style>
  .finale {
    position: relative;
    z-index: 1;
    isolation: isolate;
    width: 100%;
    min-height: 100svh;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-block: var(--space-13);
    padding-inline: var(--space-09);
    background-color: transparent;
    overflow: hidden;
  }

  /* Seam scrim: solid Canvas Black at both edges, thin through the middle */
  .finale-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      var(--color-canvas-black) 0%,
      color-mix(in srgb, var(--color-canvas-black) 25%, transparent) 26%,
      color-mix(in srgb, var(--color-canvas-black) 15%, transparent) 58%,
      var(--color-canvas-black) 100%
    );
  }

  .finale-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .finale-headline {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--font-fluid-display);
    font-weight: 600;
    line-height: var(--leading-compressed);
    letter-spacing: normal;
    color: var(--color-canvas-white);
    text-wrap: balance;
  }

  .finale-line {
    display: block;
  }

  .finale-subtext {
    max-width: 34ch;
    margin: var(--space-08) 0 0;
    font-family: var(--font-body);
    font-size: var(--font-fluid-body);
    font-weight: 400;
    line-height: var(--leading-body);
    letter-spacing: normal;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  .finale-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-06);
    margin-top: var(--space-09);
  }

  /* Primary CTA: "run" isolated in Scale VF, the sanctioned hero-CTA voice */
  .finale-cta {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-03);
    padding-block: var(--space-05);
    padding-inline: var(--space-07);
    background-color: var(--color-action-primary);
    color: var(--color-action-primary-text);
    font-family: var(--font-body);
    font-size: var(--font-size-body);
    font-weight: 500;
    line-height: var(--leading-action);
    letter-spacing: normal;
    text-transform: lowercase;
    text-decoration: none;
    border-radius: var(--radius-none);
    transition:
      background-color 0.2s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.1s ease;
  }

  .finale-cta-run {
    font-family: var(--font-wordmark);
    font-variation-settings: 'wdth' 150, 'wght' 900;
    font-weight: 900;
    line-height: var(--leading-wordmark);
  }

  .finale-cta-arrow {
    display: inline-block;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .finale-cta:hover {
    background-color: var(--color-action-primary-hover);
    box-shadow: 0 var(--space-03) var(--space-08) color-mix(in srgb, var(--color-route-orange) 32%, transparent);
  }

  .finale-cta:hover .finale-cta-arrow {
    transform: translateX(var(--space-02));
  }

  .finale-cta:active {
    transform: scale(0.985);
  }

  /* Secondary: resting hairline underline; full-strength stroke draws in left to right on hover */
  .finale-torch {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding-block: var(--space-05);
    padding-inline: var(--space-01);
    background-color: transparent;
    border: 0;
    border-radius: var(--radius-none);
    color: var(--color-canvas-white);
    font-family: var(--font-body);
    font-size: var(--font-size-body);
    font-weight: 500;
    line-height: var(--leading-action);
    letter-spacing: normal;
    text-transform: lowercase;
    cursor: pointer;
  }

  .finale-torch::before,
  .finale-torch::after {
    content: '';
    position: absolute;
    inset-inline: var(--space-01);
    bottom: var(--space-03);
    height: 1px;
  }

  .finale-torch::before {
    background-color: var(--color-border-strong);
  }

  .finale-torch::after {
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .finale-torch:hover {
    color: var(--color-pure-white);
  }

  .finale-torch:hover::after {
    transform: scaleX(1);
  }

  .finale-torch:active {
    transform: scale(0.985);
  }

  .finale-cta:focus-visible,
  .finale-torch:focus-visible {
    outline: 1px solid var(--color-canvas-white);
    outline-offset: var(--space-02);
  }

  @media (max-width: 768px) {
    .finale {
      min-height: auto;
      padding-block: var(--space-12);
      padding-inline: var(--space-05);
    }

    .finale-actions {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
      gap: var(--space-03);
    }

    .finale-cta,
    .finale-torch {
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .finale-cta,
    .finale-cta-arrow,
    .finale-torch,
    .finale-torch::after {
      transition: none;
    }
  }
</style>
