---
import AnnouncementBanner from '@/components/AnnouncementBanner';
import MobileNavDrawer from '@/components/MobileNavDrawer';
import type { SanitySettings, SanitySiteCopy } from '@/sanity/types';

export interface Props {
  class?: string;
  settings?: SanitySettings | null;
  /** @deprecated Use `settings` prop instead */
  siteCopy?: SanitySiteCopy | null;
  announcementText?: string;
  announcementLink?: string;
  showAnnouncement?: boolean;
  [key: string]: any;
}

const {
  class: className,
  settings,
  siteCopy,
  announcementText: propText,
  announcementLink: propLink,
  showAnnouncement,
  ...restProps
} = Astro.props;

const source = settings ?? (siteCopy as unknown as SanitySettings);
const bannerText = (propText ?? source?.announcementTickerText ?? '').trim();
const bannerLink = (propLink ?? source?.announcementTickerLink ?? '').trim() || undefined;

const isBannerActive = source
  ? Boolean(source.announcementEnabled && bannerText)
  : Boolean(bannerText);

const isVisible = showAnnouncement !== undefined ? showAnnouncement : isBannerActive;
---

<div class="site-header-sentinel" aria-hidden="true"></div>
<header class:list={['site-header', className]} {...restProps}>
  <!--
    CHROMIUM BLINK BACKDROP-FILTER COMPOSITOR BUG & REAL DOM VEIL FIX:
    ===================================================================
    1. The Issue:
       In Chromium-based browsers (Google Chrome, Microsoft Edge, Arc, Brave),
       the sticky header veil previously failed to render its translucent
       frosted-glass backdrop blur on scroll, displaying only an opaque darkening
       gradient scrim. This was caused by a known Blink rendering engine bug
       (Chromium Bugs 1152778 & 1205161) involving CSS pseudo-elements (::before / ::after).
       When a pseudo-element combines `position: absolute`, `backdrop-filter`, and an
       `opacity` transition (0 -> 1 on scroll), Blink's PaintLayer fails to attach
       properly to the root compositor backdrop pass (or treats it as a detached/isolated
       backdrop root under CSS Filter Effects Module Level 2), causing it to sample an
       unpopulated black/clear framebuffer rather than the underlying document pixels.

    2. Why this decision was made:
       - Direct blur animation on `.site-header[data-stuck]` (e.g. blur(0px) -> blur(28px))
         was rejected because it directly violates DESIGN.md:L249 (Static Blur Rule),
         forcing expensive per-frame GPU Gaussian shader passes and causing frame drops.
       - Hardware raster hints on pseudo-elements (will-change / translateZ) were rejected
         as brittle workarounds inconsistent across Blink patch releases.
       - The Real DOM Veil architecture (`.site-header-veil`) provides Blink with an explicit
         DOM LayoutObject having a direct parent-child stacking relationship. With
         `transform: translateZ(0)` and `will-change: opacity`, it promotes cleanly to a
         compositor layer while keeping the blur static (28px blur, 170% saturate) and
         animating only opacity. Assistive tech ignores it via `aria-hidden="true"`.

    3. How to avoid this issue in the future:
       - Never rely on CSS pseudo-elements (`::before` / `::after`) for elements combining
         `backdrop-filter` and dynamic `opacity` / visibility transitions in Chromium.
       - Always instantiate an explicit, dedicated DOM element with `aria-hidden="true"`.
       - Do NOT apply `isolation: isolate` to the header or parent containers, as that defines
         a local backdrop root preventing pixels behind the header from being sampled.
       - Ensure sibling containers (like `<main>`) do not introduce conflicting clipping or
         stacking contexts that isolate their textures from the root compositor backdrop pass.
       - Strictly respect DESIGN.md: keep `backdrop-filter` radii static and animate opacity only.
  -->
  <div class="site-header-veil" aria-hidden="true"></div>
  <!-- One landmark for the whole row: the CTA, links and menu toggle are all navigation -->
  <nav class="site-header-grid" aria-label="Primary">
    <!-- Column 1: Primary brand CTA -->
    <a href="/signup" class="nav-brand-cta">
      <span class="brand-run">run</span> <span class="brand-with">with us</span>
      <svg class="cta-route" viewBox="0 0 40 16" aria-hidden="true" focusable="false">
        <path class="cta-route-line" pathLength="1" d="M1 12 C 7 12, 9 4, 15 4 S 23 12, 29 8 L 37 8" />
        <path class="cta-route-head" pathLength="1" d="M33 4 L37 8 L33 12" />
      </svg>
    </a>

    <!-- Columns 2 & 3: Announcement Banner Slot -->
    <div class="nav-announcement-slot">
      {isVisible && bannerText && (
        <AnnouncementBanner
          text={bannerText}
          link={bannerLink}
          client:load
        />
      )}
    </div>

    <!-- Column 3: Stacked links (routes, log a run) -->
    <ul class="nav-col-stack nav-col-1">
      <li><a href="/routes" class="nav-link">routes</a></li>
      <li><a href="/log" class="nav-link">log a run</a></li>
    </ul>

    <!-- Column 4: Stacked links (donate, charities) -->
    <ul class="nav-col-stack nav-col-2">
      <li><a href="/donate" class="nav-link">donate</a></li>
      <li><a href="/charities" class="nav-link">charities</a></li>
    </ul>

    <!-- Column 5: Stacked links (home, faqs) -->
    <ul class="nav-col-stack nav-col-3">
      <li><a href="/" class="nav-link nav-link--home">home</a></li>
      <li><a href="/faqs" class="nav-link">faqs</a></li>
    </ul>

    <!-- Mobile Hamburger Toggle -->
    <button
      class="nav-mobile-toggle"
      id="nav-mobile-toggle"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <span class="nav-burger" aria-hidden="true">
        <span class="nav-burger-bar"></span>
        <span class="nav-burger-bar"></span>
      </span>
    </button>
  </nav>

  <MobileNavDrawer client:media="(max-width: 768px)" />
</header>

<script>
  import { openNav, dismissAnnouncement, $isNavOpen } from '@/stores/shell';

  const toggle = document.getElementById('nav-mobile-toggle');
  if (toggle) {
    toggle.addEventListener('click', () => {
      openNav();
    });
    $isNavOpen.subscribe((open) => {
      toggle.setAttribute('aria-expanded', String(open));
    });
  }

  // Pre-hydration click delegation: dismiss immediately if user clicks before React hydrates
  const slot = document.querySelector('.nav-announcement-slot');
  if (slot) {
    slot.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target && target.closest('.announcement-dismiss')) {
        e.preventDefault();
        e.stopPropagation();
        dismissAnnouncement();
      }
    });
  }

  // Stuck state: observe a sentinel at the document top. Unlike scroll
  // events, the observer always reports the final state (fast flings,
  // overscroll bounce, restored scroll position), so the veil can't strand.
  const header = document.querySelector<HTMLElement>('.site-header');
  const sentinel = document.querySelector('.site-header-sentinel');
  if (header && sentinel) {
    new IntersectionObserver(([entry]) => {
      header.toggleAttribute('data-stuck', !entry.isIntersecting);
    }).observe(sentinel);
  }
</script>
