---
import AnnouncementBanner from '@/components/AnnouncementBanner';
import MobileNavDrawer from '@/components/MobileNavDrawer';

export interface Props {
  class?: string;
  showAnnouncement?: boolean;
  [key: string]: any;
}

const {
  class: className,
  showAnnouncement = Astro.url.pathname === '/' || Astro.url.pathname === '',
  ...restProps
} = Astro.props;
---

<div class="site-header-sentinel" aria-hidden="true"></div>
<header class:list={['site-header', className]} {...restProps}>
  <div class="site-header-grid">
    <!-- Column 1: Primary brand CTA -->
    <a href="/signup" class="nav-brand-cta">
      <span class="brand-run">run</span> <span class="brand-with">with us</span>
      <svg class="cta-route" viewBox="0 0 40 16" aria-hidden="true" focusable="false">
        <path class="cta-route-line" pathLength="1" d="M1 12 C 7 12, 9 4, 15 4 S 23 12, 29 8 L 37 8" />
        <path class="cta-route-head" pathLength="1" d="M33 4 L37 8 L33 12" />
      </svg>
    </a>

    <!-- Columns 2 & 3: Announcement Banner Slot -->
    <div class="nav-announcement-slot">
      {showAnnouncement && <AnnouncementBanner client:load />}
    </div>

    <!-- Column 4: Stacked links (routes, charities) -->
    <div class="nav-col-stack nav-col-routes">
      <a href="/routes" class="nav-link">routes</a>
      <a href="/charities" class="nav-link">charities</a>
    </div>

    <!-- Column 5: Stacked links (donate, log a run) -->
    <div class="nav-col-stack nav-col-actions">
      <a href="/donate" class="nav-link">donate</a>
      <a href="/log" class="nav-link">log a run</a>
    </div>

    <!-- Mobile Hamburger Toggle -->
    <button class="nav-mobile-toggle" id="nav-mobile-toggle" type="button" aria-label="Toggle Navigation Menu">
      menu
    </button>
  </div>

  <MobileNavDrawer client:load />
</header>

<script>
  import { openNav, dismissAnnouncement } from '@/stores/shell';

  const toggle = document.getElementById('nav-mobile-toggle');
  if (toggle) {
    toggle.addEventListener('click', () => {
      openNav();
    });
  }

  // Pre-hydration click delegation: dismiss immediately if user clicks before React hydrates
  const slot = document.querySelector('.nav-announcement-slot');
  if (slot) {
    slot.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target && target.closest('.announcement-dismiss')) {
        e.preventDefault();
        e.stopPropagation();
        dismissAnnouncement();
      }
    });
  }

  // Stuck state: observe a sentinel at the document top. Unlike scroll
  // events, the observer always reports the final state (fast flings,
  // overscroll bounce, restored scroll position), so the veil can't strand.
  const header = document.querySelector<HTMLElement>('.site-header');
  const sentinel = document.querySelector('.site-header-sentinel');
  if (header && sentinel) {
    new IntersectionObserver(([entry]) => {
      header.toggleAttribute('data-stuck', !entry.isIntersecting);
    }).observe(sentinel);
  }
</script>
