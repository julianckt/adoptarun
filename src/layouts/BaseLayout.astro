---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import SanityFallbackToast from '@/components/SanityFallbackToast.astro';
import type { SanitySettings, SanitySiteCopy } from '@/sanity/types';
import { getSettings } from '@/sanity/queries';
import { hasImageAsset, urlForImage } from '@/sanity/image';
import { isHomePage } from '@/utils/homepage-content';

const DEFAULT_OG_IMAGE = '/images/og-default.jpg';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  /** Keep the page out of search indexes (stub and preview pages). */
  noindex?: boolean;
  class?: string;
  hideHeader?: boolean;
  hideFooter?: boolean;
  footerVariant?: 'full' | 'minimal';
  settings?: SanitySettings | null;
  /** @deprecated Use `settings` prop instead */
  siteCopy?: SanitySiteCopy | null;
  [key: string]: any;
}

const {
  title: propTitle,
  description: propDescription,
  ogImage = DEFAULT_OG_IMAGE,
  ogImageAlt = 'adopt a run wordmark on an orange and coral gradient',
  noindex = false,
  class: className,
  hideHeader = false,
  hideFooter = false,
  footerVariant = isHomePage(Astro.url.pathname) ? 'full' : 'minimal',
  settings: propSettings,
  siteCopy: propSiteCopy,
  ...restProps
} = Astro.props;

// Use Sanity as default, falling back to settings or legacy siteCopy prop if Sanity fetch fails
const sanitySettings = await getSettings().catch(() => null);
const resolvedSettings = propSettings ?? sanitySettings ?? (propSiteCopy as unknown as SanitySettings) ?? null;

const title = propTitle ?? resolvedSettings?.seoTitle ?? 'adopt a run — gps art community movement';
const description =
  propDescription ??
  resolvedSettings?.seoDescription ??
  'an international gps-art community movement debuting in hong kong. bringing people together through long-distance running, jogging, or walking and community art to champion a kinder city.';

let resolvedOgImage = ogImage;
if (ogImage === DEFAULT_OG_IMAGE && resolvedSettings?.ogImage && hasImageAsset(resolvedSettings.ogImage)) {
  resolvedOgImage = urlForImage(resolvedSettings.ogImage)
    .width(1200)
    .height(630)
    .fit('crop')
    .auto('format')
    .url();
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://adoptarun.org');
const ogImageURL = new URL(resolvedOgImage, canonicalURL);
// Dimensions are only known for the bundled default artwork.
const isDefaultOgImage = resolvedOgImage === DEFAULT_OG_IMAGE;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <!-- Pre-paint check to prevent announcement banner FOUC -->
    <script is:inline>
      try {
        if (sessionStorage.getItem('adoptarun_announcement_dismissed') === 'true') {
          document.documentElement.classList.add('announcement-dismissed');
        }
      } catch (e) {}
    </script>

    <!-- Adobe Fonts (Typekit kit pyi8tbr: degular-variable, runda, scale-variable) -->
    <link rel="preconnect" href="https://use.typekit.net" crossorigin />
    <link rel="preconnect" href="https://p.typekit.net" crossorigin />
    <script is:inline>
      (function(d) {
        var config = {
          kitId: 'pyi8tbr',
          scriptTimeout: 3000,
          async: true
        },
        h=d.documentElement,t=setTimeout(function(){h.className=h.className.replace(/\bwf-loading\b/g,"")+" wf-inactive";},config.scriptTimeout),tk=d.createElement("script"),f=false,s=d.getElementsByTagName("script")[0],a;h.className+=" wf-loading";tk.src='https://use.typekit.net/'+config.kitId+'.js';tk.async=true;tk.onload=tk.onreadystatechange=function(){a=this.readyState;if(f||a&&a!="complete"&&a!="loaded")return;f=true;clearTimeout(t);try{Typekit.load(config)}catch(e){}};s.parentNode.insertBefore(tk,s)
      })(document);
    </script>

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    {isDefaultOgImage && <meta property="og:image:type" content="image/jpeg" />}
    {isDefaultOgImage && <meta property="og:image:width" content="1200" />}
    {isDefaultOgImage && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:site_name" content="adopt a run" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
  </head>
  <body class:list={['adoptarun-shell', className]} {...restProps}>
    {!hideHeader && <Header settings={resolvedSettings} />}
    <slot />
    {!hideFooter && <Footer variant={footerVariant} settings={resolvedSettings} />}
    <!-- Preview-only extras (the Visual Editing island on /preview); public pages leave this empty. -->
    <slot name="body-end" />

    <!-- Unified SVG Sprites -->
    <svg xmlns="http://www.w3.org/2000/svg" style="display: none;" aria-hidden="true">
      <symbol id="icon-arrow-up-right" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M4 12L12 4M5 4h7v7" />
      </symbol>
    </svg>
    <SanityFallbackToast />
  </body>
</html>
