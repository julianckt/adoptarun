{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "adoptarun",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  // Adoptions, the Adopter ID sequence, and verified run telemetry.
  // Reached as `locals.runtime.env.DB` — which is why the Cloudflare adapter is
  // attached in dev too, so `astro dev` runs in workerd against a local replica
  // of this schema rather than having no binding at all.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "adoptarun-d1",
      "database_id": "169150e7-d9fc-4b0b-aec2-1986483e5b87",
      "migrations_dir": "migrations"
    }
  ]
}