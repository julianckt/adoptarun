PUBLIC_SANITY_PROJECT_ID="huk9xx07"
PUBLIC_SANITY_DATASET="production"
PUBLIC_SANITY_API_VERSION="2026-03-01"

# Server-only Viewer token for the on-demand /preview route used by Studio Presentation.
# Production: set as a Cloudflare Worker secret, never as a PUBLIC_ variable.
SANITY_API_READ_TOKEN=""

# CARTO Basemap API Keys
PUBLIC_CARTO_API_KEY_DEV=""
PUBLIC_CARTO_API_KEY_PROD=""

# Slack Incoming Webhook for build-time issues needing action: Sanity fetch
# failure/cache fallback, dangling image asset references.
# Production: set as a Cloudflare Workers Build environment variable, not committed.
SLACK_WEBHOOK_ACT_ON=""
